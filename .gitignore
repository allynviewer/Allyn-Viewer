# Allyn Viewer — files that must not go to GitHub
# Based on Second Life viewer (develop) and Firestorm phoenix-firestorm
# .gitignore, plus local Windows 64-bit / Cursor / Python leftovers.
#
# Do commit: source (indra/), autobuild.xml, build.bat, LICENSE, skins, doc/
# Do not commit: builds, packages, IDE settings, venv, logs, personal caches.

# --- Local Python / tools (this machine) ---
.venv/
venv/
.env
.env.*
.cache/
.cache/clangd/
Lib/
lib64/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
Pipfile.lock

# --- IDE / editor (personal) ---
.vscode/
.vs/
.idea/
.cursor/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.aps
*.vshost.exe
*~
*.swp
*.swo

# --- OS junk ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- CMake / Visual Studio generated (never the source of truth) ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
CTestTestfile.cmake
compile_commands.json
*.vcxproj
*.vcxproj.filters
*.sln
*.dir/
ipch/
