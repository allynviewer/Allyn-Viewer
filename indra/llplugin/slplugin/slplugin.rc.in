// Version resource for SLPlugin.exe.
//
// Configured by CMake (indra/llplugin/slplugin/CMakeLists.txt). The signed
// binaries must carry the same ProductName ("Allyn Viewer") and ProductVersion
// as the viewer executable: SignPath enforces both through file metadata
// restrictions in the artifact configuration (see doc/code_signing.md).

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ${VIEWER_VERSION_MAJOR},${VIEWER_VERSION_MINOR},${VIEWER_VERSION_PATCH},${VIEWER_VERSION_REVISION}
 PRODUCTVERSION ${VIEWER_VERSION_MAJOR},${VIEWER_VERSION_MINOR},${VIEWER_VERSION_PATCH},${VIEWER_VERSION_REVISION}
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Allyn Viewer"
            VALUE "FileDescription", "${VIEWER_CHANNEL} plugin host"
            VALUE "FileVersion", "${VIEWER_VERSION_MAJOR}.${VIEWER_VERSION_MINOR}.${VIEWER_VERSION_PATCH}.${VIEWER_VERSION_REVISION}"
            VALUE "InternalName", "SLPlugin"
            VALUE "LegalCopyright", "Copyright © 2001-2010, Linden Research, Inc. Allyn Viewer modifications © 2026 Allef A. Silva"
            VALUE "OriginalFilename", "SLPlugin.exe"
            VALUE "ProductName", "Allyn Viewer"
            VALUE "ProductVersion", "${VIEWER_VERSION_MAJOR}.${VIEWER_VERSION_MINOR}.${VIEWER_VERSION_PATCH}.${VIEWER_VERSION_REVISION}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
