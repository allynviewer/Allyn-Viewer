<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="floater_web_content" title="Navigateur Web">
	<layout_stack name="stack1">
		<layout_panel name="nav_controls">
			<button name="back" tool_tip="Page précédente"/>
			<button name="forward" tool_tip="Page suivante"/>
			<button name="stop" tool_tip="Arrêter la navigation"/>
			<button name="reload" tool_tip="Recharger la page"/>
			<combo_box name="address" tool_tip="Saisissez l'URL ici"/>
			<icon name="media_secure_lock_flag" tool_tip="Navigation sécurisée"/>
			<button name="popexternal" tool_tip="Ouvrir l'URL actuelle dans votre navigateur de bureau"/>
		</layout_panel>
	</layout_stack>
</floater>
