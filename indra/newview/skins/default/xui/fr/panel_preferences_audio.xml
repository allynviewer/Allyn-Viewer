<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel border="true" bottom="-409" height="408" label="Audio et vidéo" left="102" name="Media panel" width="517">
	<scroll_container name="audio_scroll">
		<panel name="audio_scroll_inner">
			<text bottom="-22" height="12" left="10" name="muting_text">Volume :</text>
			<text bottom="-190" name="streaming_prefs_text">Préférences de flux :</text>
			<text bottom="-311" height="12" name="audio_prefs_text">Préférences audio :</text>
			<panel border="true" bottom="-172" filename="panel_audio.xml" height="165" label="Volume" left="142" name="Volume Panel" width="260" />
			<text bottom="-190" name="Media Filtering">Filtrage des médias</text>
			<radio_group bottom_delta="-20" control_name="MediaEnableFilter" follows="top" height="30" width="316" tab_stop="true" draw_border="true" name="filter_group">
				<radio_item bottom_delta="0" name="0" value="0">Désactivé</radio_item>
				<radio_item bottom_delta="0" left_delta="60" name="1" value="1">Liste noire uniquement</radio_item>
				<radio_item bottom_delta="0" left_delta="60" name="2" value="2">Demander</radio_item>
			</radio_group>
			<check_box label="Jouer la musique disponible (gourmand en bande passante)" name="streaming_music" />
			<check_box label="Jouer le média disponible (gourmand en bande passante)" name="streaming_video" />
			<check_box label="Joue automatiquement le média sur un prim" name="auto_prim_streaming_video" />
			<check_box label="Joue automatiquement les médias sur la parcelle" name="auto_streaming_video" />
			<check_box bottom_delta="-25" control_name="MuteWhenMinimized" follows="top" height="16" initial_value="true" label="Couper le son lorsque la fenêtre est minimisée" left="142" name="mute_when_minimized" />
			<slider bottom_delta="-20" control_name="AudioLevelDoppler" edit_text="true" follows="top" height="15" increment="0.1" initial_val="1" label="Effet Doppler" label_width="130" left="148" max_val="2" min_val="0" name="Doppler Effect" show_text="true" width="300" />
			<slider bottom_delta="-20" control_name="AudioLevelRolloff" edit_text="true" follows="top" height="15" increment="0.1" initial_val="1" label="Facteur d'atténuation (par défaut)" label_width="130" max_val="2" min_val="0" name="Rolloff Factor" width="300" />
			<slider bottom_delta="-20" control_name="AudioLevelUnderwaterRolloff" edit_text="true" follows="top" height="15" increment="0.1" initial_val="3" label="Facteur d'atténuation (sous-marin)" label_width="130" max_val="8" min_val="0" name="Underwater Rolloff Factor" width="300" />
			<spinner bottom_delta="-20" control_name="UISndMoneyChangeThreshold" decimal_digits="0" follows="top" height="16" increment="10" initial_val="10" label="Seuil de changement [CURRENCY] :" label_width="128" max_val="10000" min_val="0" name="currency_change_threshold" width="192" />
			<spinner bottom_delta="-20" control_name="UISndHealthReductionThreshold" decimal_digits="0" follows="top" height="16" increment="10" initial_val="20" label="Seuil de changement de santé" label_width="128" max_val="10000" min_val="0" name="Health Change Threshold" width="192" />
		</panel>
	</scroll_container>
</panel>
