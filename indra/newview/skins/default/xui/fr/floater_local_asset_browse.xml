<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="local_bitmap_browser_floater" title="Navigateur de bitmaps locaux">
	<button name="add_btn" label="Ajouter"/>
	<button name="del_btn" label="Retirer"/>
	<button name="upload_btn" label="Charger"/>
	<button name="more_btn" label="Plus"/>
	<button name="less_btn" label="Moins"/>
	<scroll_list name="bitmap_list">
		<column name="bitmap_name" label="Nom"/>
		<column name="bitmap_uuid" label="UUID"/>
	</scroll_list>
	<text name="path_caption_text">Chemin local :</text>
	<text name="uuid_caption_text">UUID local :</text>
	<texture_picker name="texture_view" label="Texture"/>
	<check_box name="keep_updating_checkbox" label="Continuer à mettre à jour" tool_tip="Activer ou désactiver la vérification périodique si le bitmap source sur votre disque a été mis à jour"/>
	<combo_box name="type_combobox">
		<combo_item name="type_texture">Texture</combo_item>
		<combo_item name="type_sculptie">Carte sculptée</combo_item>
		<combo_item name="type_layer">Vêtement</combo_item>
	</combo_box>
	<text name="time_caption_text">Heure :</text>
	<text name="time_text">(date ici)</text>
	<text name="link_caption_text">Lien :</text>
	<text name="link_text">(état du lien)</text>
	<text name="name_caption_text">Nom :</text>
</floater>
