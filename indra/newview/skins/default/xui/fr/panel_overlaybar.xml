<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="overlay">
	<button name="Mouselook" label="mouselock" label_selected="mouselock" tool_tip="Utilisez la souris pour diriger votre vue. Si vous avez une arme, vous pouvez tirer en cliquant."/>
	<layout_stack name="overlay_layout_panel">
		<layout_panel min_width="0" name="main_panel" width="410">
			<layout_stack name="chatbar_and_buttons" right="410">
				<layout_panel name="padding" width="410"/>
				<layout_panel name="state_management_buttons_container" width="410">
					
					<button label="Disponible" label_selected="Disponible" name="Set Not Busy" tool_tip="Le chat et les IM ne s&apos;affichent pas. Cliquez ici pour ne plus être en mode occupé(e)."/>
					<button label="Flycam" label_selected="Flycam" name="Flycam" tool_tip="Votre caméra est contrôlée par le joystick, cliquez ici pour la libérer."/>
					<button label="Me lever" label_selected="Me lever" name="Stand Up" tool_tip="Cliquez ici pour vous lever."/>
					<button label="IM Reçu" label_selected="IM Reçu" left="0"
					 name="New IM" scale_image="true"
					 tool_tip="Im en attente."
					 width="150" />
				</layout_panel>
 <layout_panel name="chat_bar_layout_panel">
 <panel name="chat_bar"/>
 </layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel min_width="114" name="media_remote_container" width="114">
			<button name="overlay_volume_btn" label="Volume" label_selected="Volume"/>
		</layout_panel>
		<layout_panel name="ao_remote_container">
			<button name="overlay_ao_btn" label="AO OFF" label_selected="AO ON"/>
		</layout_panel>
		<layout_panel name="AdvSettings_container">
			<button name="overlay_env_btn" label="Climat" label_selected="Climat"/>
		</layout_panel>
		<layout_panel name="voice_remote_container"/>
	</layout_stack>
</panel>
