<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel name="script_limits_my_avatar_panel" label="Mon avatar">
	<text name="script_memory">Utilisation des scripts de l'avatar</text>
	<text name="loading_text">Chargement...</text>
	<scroll_list name="scripts_list">
		<column name="name" label="Objet"/>
		<column name="size" label="Taille" tool_tip="Taille en kilo-octets"/>
		<column name="urls" label="URL"/>
		<column name="location" label="Emplacement"/>
	</scroll_list>
	<button name="refresh_list_btn" label="Actualiser la liste"/>
</panel>
