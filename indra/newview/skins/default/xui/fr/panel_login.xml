<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<string name="online_users_title">UTILISATEURS EN LIGNE</string>
	<string name="online_allyn_label">ALLYN VIEWER</string>
	<string name="online_sl_label">SECOND LIFE</string>
	<panel name="login_form_bg">
		<scroll_container name="login_form_scroll">
			<panel name="login_form_inner">
				<panel name="online_users_panel">
					<text name="online_users_title">UTILISATEURS EN LIGNE</text>
				</panel>
				<text name="login_title">ALLYN VIEWER</text>
				<text name="login_subtitle">Connectez-vous pour continuer</text>
				<text name="name_label">Nom d'utilisateur</text>
				<text name="password_text">Mot de passe</text>
				<panel name="location_panel">
					<text name="start_location_text">Lieu de départ</text>
					<combo_box name="start_location_combo">
						<combo_item name="MyHome">Domicile</combo_item>
						<combo_item name="MyLastLocation">Dernier lieu</combo_item>
						<combo_item name="Typeregionname">&lt;région&gt;</combo_item>
					</combo_box>
				</panel>
				<button label="Connexion" label_selected="Connexion" name="connect_btn"/>
				<check_box label="Mémoriser le nom" name="remember_name_check"/>
				<button name="remove_login" tool_tip="Effacer ce login enregistré"/>
				<check_box label="Mémoriser le mot de passe" name="remember_check"/>
				<text name="create_new_account_text">Créer un compte</text>
				<text name="forgot_password_text">Mot de passe oublié ?</text>
				<panel name="grids_panel">
					<text name="grids_combo_text">Grid ou URI de connexion :</text>
					<combo_box name="grids_combo" tool_tip="Nom du grid ou URI de connexion"/>
					<button name="grids_btn" label="Gérer les grids"/>
				</panel>
			</panel>
		</scroll_container>
	</panel>
</panel>
