<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel label="Événements">
	<layout_stack name="experience_panel">
		<layout_panel name="event_panel">
			<scroll_list name="experience_log_list">
				<columns name="time" label="Heure"/>
				<columns name="event" label="Événement"/>
				<columns name="experience_name" label="Expérience"/>
				<columns name="object_name" label="Objet"/>
			</scroll_list>
			<button name="btn_notify" label="Notifier"/>
			<button name="btn_profile_xp" label="Profil"/>
			<button name="btn_report_xp" label="Signaler"/>
		</layout_panel>
		<layout_panel name="button_panel">
			<check_box name="notify_all" label="Notifier tous les événements Jours"/>
			<button name="btn_clear" label="Effacer"/>
		</layout_panel>
	</layout_stack>
</panel>
