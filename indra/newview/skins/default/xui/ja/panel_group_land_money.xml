<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="land_money_tab" label="土地と資金">
	<string name="help_text">グループが所有するパーセルと貢献の詳細が一覧表示されます。「使用中の土地合計」が「貢献合計」以下になるまで警告が表示されます。「計画」「詳細」「販売」タブではグループの財務情報を確認できます。</string>
	<button name="help_button" label="?" />
	<string name="cant_view_group_land_text">グループ所有の土地を表示する権限がありません。</string>
	<string name="epmty_view_group_land_text">項目がありません</string>
	<string name="cant_view_group_accounting_text">グループの会計情報を表示する権限がありません。</string>
	<string name="loading_txt">読み込み中...</string>
	<text name="group_land_heading">グループ所有の土地</text>
	<scroll_list name="group_parcel_list">
		<column name="name" label="パーセル名" />
		<column name="location" label="リージョン" />
		<column name="type" label="タイプ" />
		<column name="area" label="面積" />
		<column name="hidden" />
	</scroll_list>
	<button name="map_button" label="マップで表示" />
	<text name="total_contributed_land_label">貢献合計:</text>
	<text name="total_contributed_land_value">[AREA] 平方メートル</text>
	<text name="total_land_in_use_label">使用中の土地合計:</text>
	<text name="total_land_in_use_value">[AREA] 平方メートル</text>
	<text name="land_available_label">利用可能な土地:</text>
	<text name="land_available_value">[AREA] 平方メートル</text>
	<text name="your_contribution_label">あなたの貢献:</text>
	<line_editor name="your_contribution_line_editor" />
	<string name="land_contrib_error">土地の貢献を設定できませんでした。</string>
	<text name="your_contribution_max_value">平方メートル（最大 [AMOUNT]）</text>
	<icon name="group_over_limit_icon" />
	<text name="group_over_limit_text">使用中の土地を維持するには、グループメンバーがより多くの土地クレジットを貢献する必要があります。</text>
	<text name="group_money_heading">グループ[CURRENCY]</text>
	<tab_container name="group_money_tab_container">
		<panel name="group_money_planning_tab" label="計画">
			<text_editor name="group_money_planning_text">計算中...</text_editor>
		</panel>
		<panel name="group_money_details_tab" label="詳細">
			<text_editor name="group_money_details_text">計算中...</text_editor>
			<button name="earlier_details_button" label="&lt; 前へ" tool_tip="前の期間へ" />
			<button name="later_details_button" label="次へ &gt;" tool_tip="次の期間へ" />
		</panel>
		<panel name="group_money_sales_tab" label="販売">
			<text_editor name="group_money_sales_text">計算中...</text_editor>
			<button name="earlier_sales_button" label="&lt; 前へ" tool_tip="前の期間へ" />
			<button name="later_sales_button" label="次へ &gt;" tool_tip="次の期間へ" />
		</panel>
	</tab_container>
</panel>
