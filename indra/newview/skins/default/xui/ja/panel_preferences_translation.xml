 <text name="in_disp_label">受信:</text>
 <combo_box name="incoming_display">
 <combo_item name="translation_only">翻訳のみ（原文を非表示）</combo_item>
 <combo_item name="both">原文と翻訳</combo_item>
 </combo_box>
 <text name="out_disp_label">送信:</text>
 <combo_box name="outgoing_display">
 <combo_item name="translation_only">翻訳のみ（原文を非表示）</combo_item>
 <combo_item name="both">原文と翻訳</combo_item>
 </combo_box>
 <text name="in_color_label">受信の色:</text>
 <color_swatch name="incoming_color"/>
 <text name="out_color_label">送信の色:</text>
 <color_swatch name="outgoing_color"/>
 <text name="privacy_tip">自分の言語 / 相手の言語 = 任意の言語（ISO コード: ja, ru, zh...）。&#10;送信: 自分→相手。受信: 相手→自分。&#10;[IA] は受信のみ。既に対象言語の場合は重複行を表示しません。</text>
 </panel>
 <panel label="グループ" name="Groups">
 <check_box label="グループチャットを翻訳" name="groups_enable"/>
 <text name="group_mode_label">グループ:</text>
 <combo_box name="group_mode">
 <combo_item name="all">すべてのマイグループ</combo_item>
 <combo_item name="selected">下で選択したもののみ</combo_item>
 </combo_box>
 <scroll_list name="group_list" tool_tip="Ctrl+クリックで複数のグループを選択（選択モード）">
 <column label="グループ" name="name"/>
 </scroll_list>
 <button label="グループ一覧を更新" name="group_refresh_btn"/>
 </panel>
 <panel label="プロバイダー" name="Provider">
 <text name="provider_label">プロバイダー:</text>
 <combo_box name="provider_combo">
 <combo_item name="openai">OpenAI (ChatGPT)</combo_item>
 <combo_item name="anthropic">Anthropic (Claude)</combo_item>
 <combo_item name="opencode_zen">OpenCode Zen</combo_item>
 <combo_item name="openrouter">OpenRouter</combo_item>
 <combo_item name="custom">カスタム（OpenAI 互換）</combo_item>
 </combo_box>
 <text name="key_label">APIキー:</text>
 <line_editor name="api_key"/>
 <text name="url_label">ベース URL:</text>
 <line_editor name="base_url"/>
 <text name="model_label">モデル:</text>
 <line_editor name="model"/>
 <button label="接続をテスト" name="test_btn"/>
 <text name="status_text">未テスト</text>
 <text name="provider_tip">APIキーはこのPCのローカル設定にのみ保存されます。&#10;OpenCode Zen: chat/completions（例: mimo-v2.5-free）。&#10;OpenRouter: https://openrouter.ai/api/v1（例: minimax/minimax-m3:free）。</text>
 </panel>
 </tab_container>
</panel>
