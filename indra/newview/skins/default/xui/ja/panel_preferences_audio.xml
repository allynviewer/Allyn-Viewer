			<text name="Media Filtering">メディアフィルタ</text>
			<icon name="section_filter_rule" />
			<radio_group name="filter_group">
				<radio_item name="0">オフ</radio_item>
				<radio_item name="1">ブラックリストのみ</radio_item>
				<radio_item name="2">確認する</radio_item>
			</radio_group>
			<text name="streaming_prefs_text">ストリーミング</text>
