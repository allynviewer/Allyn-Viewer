<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="floater_web_content" title="Web ブラウザ">
	<layout_stack name="stack1">
		<layout_panel name="nav_controls">
			<button name="back" tool_tip="戻る" />
			<button name="forward" tool_tip="前進" />
			<button name="stop" tool_tip="読み込みを停止" />
			<button name="reload" tool_tip="ページを再読み込み" />
			<combo_box name="address" tool_tip="URLを入力" />
			<icon name="media_secure_lock_flag" tool_tip="セキュアブラウジング" />
			<button name="popexternal" tool_tip="現在のURLをデスクトップブラウザで開く" />
		</layout_panel>
		<layout_panel name="external_controls">
			<web_browser name="webbrowser" />
		</layout_panel>
		<layout_panel name="status_bar">
			<text name="statusbartext" />
			<progress_bar name="statusbarprogress" />
		</layout_panel>
	</layout_stack>
</floater>
