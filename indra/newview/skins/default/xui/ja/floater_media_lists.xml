<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="floatermedialists" title="メディア フィルター">
	<floater.string name="EnterUrlAllow">常に許可するドメインまたは URL:</floater.string>
	<floater.string name="EnterUrlDeny">許可しないドメインまたは URL:</floater.string>
	<layout_stack name="lists_layout_stack">
		<layout_panel name="whitelist_layout_panel">
			<scroll_list name="whitelist">
				<column name="list" label="許可されたドメイン" />
			</scroll_list>
			<layout_stack name="whitelist_buttons_layout_stack">
				<layout_panel name="whitelist_buttons_panel_add">
					<button name="add_whitelist" label="追加..." />
				</layout_panel>
				<layout_panel name="whitelist_buttons_panel_remove">
					<button name="remove_whitelist" label="削除" />
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="blacklist_layout_panel">
			<scroll_list name="blacklist">
				<column name="list" label="ブロック済みドメイン" />
			</scroll_list>
			<layout_stack name="blacklist_buttons_layout_stack">
				<layout_panel name="blacklist_buttons_panel_add">
					<button name="add_blacklist" label="追加..." />
				</layout_panel>
				<layout_panel name="blacklist_buttons_panel_remove">
					<button name="remove_blacklist" label="削除" />
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</floater>
