<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<mimetypes name="default">
	<defaultlabel>（不明）</defaultlabel>
	<defaultwidget>none</defaultwidget>
	<defaultimpl>media_plugin_cef</defaultimpl>
	<widgetset name="web">
		<label name="web_label">Web コンテンツ</label>
		<icon>icn_media_web.tga</icon>
		<default_type>text/html</default_type>
		<tooltip name="web_tooltip">この場所にはWebコンテンツがあります</tooltip>
		<playtip name="web_playtip">Web コンテンツを表示</playtip>
		<allow_resize>true</allow_resize>
		<allow_looping>false</allow_looping>
	</widgetset>
	<widgetset name="movie">
		<label name="movie_label">動画</label>
		<default_type>video/*</default_type>
		<icon>icn_media_movie.tga</icon>
		<tooltip name="movie_tooltip">この場所で再生できる動画があります</tooltip>
		<playtip name="movie_playtip">動画を再生</playtip>
		<allow_resize>false</allow_resize>
		<allow_looping>true</allow_looping>
	</widgetset>
	<widgetset name="image">
		<label name="image_label">画像</label>
		<icon>icn_media_web.tga</icon>
		<default_type>image/*</default_type>
		<tooltip name="image_tooltip">この場所には画像があります</tooltip>
		<playtip name="image_playtip">この場所の画像を表示</playtip>
		<allow_resize>false</allow_resize>
		<allow_looping>false</allow_looping>
	</widgetset>
	<widgetset name="audio">
		<label name="audio_label">オーディオ</label>
		<icon>icn_media_web.tga</icon>
		<default_type>audio/*</default_type>
		<tooltip name="audio_tooltip">この場所にはオーディオがあります</tooltip>
		<playtip name="audio_playtip">この場所のオーディオを再生</playtip>
		<allow_resize>false</allow_resize>
		<allow_looping>true</allow_looping>
	</widgetset>
	<widgetset name="none">
		<label name="none_label">コンテンツなし</label>
		<default_type>none/none</default_type>
		<icon>icn_media_web.tga</icon>
		<tooltip name="none_tooltip">メディアはありません</tooltip>
		<playtip name="none_playtip" />
		<allow_resize>false</allow_resize>
		<allow_looping>false</allow_looping>
	</widgetset>
	<scheme name="rtsp">
		<label name="rtsp_label">リアルタイムストリーミング</label>
		<widgettype>movie</widgettype>
		<impl>media_plugin_libvlc</impl>
	</scheme>
	<scheme name="example">
		<label name="example_label">プラグインスキームの例</label>
		<widgettype>movie</widgettype>
		<impl>media_plugin_example</impl>
	</scheme>
	<scheme name="libvlc">
		<label name="libvlc_label">LibVLC対応メディア</label>
		<widgettype>movie</widgettype>
		<impl>media_plugin_libvlc</impl>
	</scheme>
	<mimetype name="blank">
		<label name="blank_label">- なし -</label>
		<widgettype>none</widgettype>
		<impl>media_plugin_cef</impl>
	</mimetype>
