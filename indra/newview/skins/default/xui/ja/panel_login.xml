<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<string name="online_users_title">オンラインユーザー</string>
	<string name="online_allyn_label">ALLYN VIEWER</string>
	<string name="online_sl_label">SECOND LIFE</string>
	<panel name="login_form_bg">
		<scroll_container name="login_form_scroll">
			<panel name="login_form_inner">
				<panel name="online_users_panel">
					<text name="online_users_title">オンラインユーザー</text>
				</panel>
				<text name="login_title">ALLYN VIEWER</text>
				<text name="login_subtitle">続行するにはサインインしてください</text>
				<text name="name_label">ユーザー名</text>
				<text name="password_text">パスワード</text>
				<panel name="location_panel">
					<text name="start_location_text">開始位置</text>
					<combo_box name="start_location_combo">
						<combo_item name="MyHome">マイホーム</combo_item>
						<combo_item name="MyLastLocation">前回の位置</combo_item>
						<combo_item name="Typeregionname">&lt;リージョン名&gt;</combo_item>
					</combo_box>
				</panel>
				<button label="ログイン" label_selected="ログイン" name="connect_btn"/>
				<check_box label="ユーザー名を保存" name="remember_name_check"/>
				<button name="remove_login" tool_tip="選択中の保存済みログイン情報を削除"/>
				<check_box label="パスワードを保存" name="remember_check"/>
				<text name="create_new_account_text">アカウント登録</text>
				<text name="forgot_password_text">ユーザー名またはパスワードをお忘れですか？</text>
				<panel name="grids_panel">
					<text name="grids_combo_text">グリッドまたはログイン URI:</text>
					<combo_box name="grids_combo" tool_tip="既知のグリッド名またはログイン URI を入力、または一覧から選択"/>
					<button name="grids_btn" label="グリッド管理"/>
				</panel>
			</panel>
		</scroll_container>
	</panel>
</panel>
