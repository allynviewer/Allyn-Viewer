			<combo_item name="filter_by_linkset_use_exclusion_volume">除外ボリューム</combo_item>
			<combo_item name="filter_by_linkset_use_dynamic_phantom">移動可能なファントム</combo_item>
		</combo_box>
		<button name="apply_filters" label="適用" />
		<button name="clear_filters" label="クリア" />
		<scroll_list name="objects_scroll_list">
			<column name="name" label="名前（ルートプリム）" />
