	<panel name="pathfinding_linksets_main">
		<text name="linksets_filter_label">フィルター:</text>
		<text name="linksets_name_label">名前</text>
		<line_editor name="filter_by_name" />
		<text name="linksets_desc_label">説明</text>
		<line_editor name="filter_by_description" />
		<combo_box name="filter_by_linkset_use">
			<combo_item name="filter_by_linkset_use_none">リンクセットの用途でフィルター...</combo_item>
			<combo_item name="filter_by_linkset_use_walkable">歩行可能</combo_item>
			<combo_item name="filter_by_linkset_use_static_obstacle">静止障害物</combo_item>
