<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="Texture" label="テクスチャ">
	<panel.string name="string repeats per meter">メートルあたりの繰り返し</panel.string>
	<panel.string name="string repeats per face">面あたりの繰り返し</panel.string>
	<text name="color label">カラー</text>
	<color_swatch name="colorswatch" tool_tip="クリックしてカラーピッカーを開く" />
	<text name="color trans">アルファ %</text>
	<spinner name="ColorTrans" />
	<text name="glow label">グロー</text>
	<spinner name="glow" />
	<check_box name="checkbox fullbright" label="フルブライト" />
	<combo_box name="combobox matmedia">
		<combo_box.item name="Materials" label="マテリアル" />
		<combo_box.item name="Media" label="メディア" />
	</combo_box>
	<combo_box name="combobox mattype">
		<combo_box.item name="Texture (diffuse)" label="テクスチャ (拡散)" />
		<combo_box.item name="Bumpiness (normal)" label="凹凸（法線）" />
		<combo_box.item name="Shininess (specular)" label="光沢（スペキュラ）" />
	</combo_box>
	<texture_picker name="texture control" label="テクスチャ" tool_tip="クリックして画像を選択" />
	<text name="label alphamode">アルファモード</text>
	<combo_box name="combobox alphamode">
		<combo_box.item name="None" label="なし" />
		<combo_box.item name="Alpha blending" label="アルファブレンド" />
		<combo_box.item name="Alpha masking" label="アルファマスク" />
		<combo_box.item name="Emissive mask" label="発光マスク" />
	</combo_box>
	<text name="label maskcutoff">マスクカットオフ</text>
	<spinner name="maskcutoff" />
	<texture_picker name="bumpytexture control" label="テクスチャ" tool_tip="クリックして画像を選択" />
	<text name="label bumpiness">凹凸</text>
	<combo_box name="combobox bumpiness">
		<combo_box.item name="None" label="なし" />
		<combo_box.item name="Brightness" label="明るさ" />
		<combo_box.item name="Darkness" label="暗闇" />
		<combo_box.item name="woodgrain" label="木目" />
		<combo_box.item name="bark" label="bark" />
		<combo_box.item name="bricks" label="レンガ" />
		<combo_box.item name="checker" label="チェッカー" />
		<combo_box.item name="concrete" label="コンクリート" />
		<combo_box.item name="crustytile" label="crustytile" />
		<combo_box.item name="cutstone" label="cutstone" />
		<combo_box.item name="discs" label="ディスク" />
		<combo_box.item name="gravel" label="砂利" />
		<combo_box.item name="petridish" label="petridish" />
		<combo_box.item name="siding" label="サイディング" />
		<combo_box.item name="stonetile" label="stonetile" />
		<combo_box.item name="stucco" label="スタッコ" />
		<combo_box.item name="suction" label="吸引" />
		<combo_box.item name="weave" label="織り" />
	</combo_box>
	<texture_picker name="shinytexture control" label="テクスチャ" tool_tip="クリックして画像を選択" />
	<text name="label shininess">光沢度</text>
	<combo_box name="combobox shininess">
		<combo_box.item name="None" label="なし" />
		<combo_box.item name="Low" label="低" />
		<combo_box.item name="Medium" label="中" />
		<combo_box.item name="High" label="高" />
	</combo_box>
	<text name="label glossiness">光沢</text>
	<spinner name="glossiness" />
	<text name="label environment">環境</text>
	<spinner name="environment" />
	<text name="label shinycolor">カラー</text>
	<color_swatch name="shinycolorswatch" tool_tip="クリックしてカラーピッカーを開く" />
	<text name="media_info">選択中のメディアがあれば、ここにURLが表示されます</text>
	<button name="add_media" label="選択..." tool_tip="メディアを追加" />
	<button name="delete_media" label="削除" tool_tip="このメディアテクスチャを削除" />
	<button name="button align" label="整列" tool_tip="メディアテクスチャを整列（先に読み込みが必要）" />
	<check_box name="checkbox maps sync" label="マテリアルを同期" tool_tip="テクスチャマップのパラメータを同期します" />
	<text name="tex gen">マッピング</text>
	<combo_box name="combobox texgen">
		<combo_box.item name="Default" label="デフォルト" />
		<combo_box.item name="Planar" label="平面" />
	</combo_box>
	<check_box name="checkbox planar align" label="平面整列" tool_tip="選択したすべての面のテクスチャを最後に選択した面に合わせます。平面テクスチャマッピングが必要です。" />
	<spinner name="TexScaleU" label="水平スケール" />
	<button name="flipTextureScaleU" tool_tip="反転" />
	<spinner name="TexScaleV" label="垂直スケール" />
	<button name="flipTextureScaleV" tool_tip="反転" />
	<spinner name="rptctrl" label="メートルあたりの繰り返し" />
	<spinner name="TexRot" label="回転 (度)" />
	<spinner name="TexOffsetU" label="水平オフセット" />
	<spinner name="TexOffsetV" label="垂直オフセット" />
	<spinner name="bumpyScaleU" label="水平スケール" />
	<spinner name="bumpyScaleV" label="垂直スケール" />
	<spinner name="bumpyRot" label="回転 (度)" />
	<spinner name="bumpyOffsetU" label="水平オフセット" />
	<spinner name="bumpyOffsetV" label="垂直オフセット" />
	<spinner name="shinyScaleU" label="水平スケール" />
	<spinner name="shinyScaleV" label="垂直スケール" />
	<spinner name="shinyRot" label="回転 (度)" />
	<spinner name="shinyOffsetU" label="水平オフセット" />
	<spinner name="shinyOffsetV" label="垂直オフセット" />
	<button name="copytextures" label="コピー" tool_tip="テクスチャパラメータをコピー" />
	<button name="pastetextures" label="貼り付け" tool_tip="テクスチャパラメータを貼り付け" />
	<web_browser name="title_media" />
</panel>
