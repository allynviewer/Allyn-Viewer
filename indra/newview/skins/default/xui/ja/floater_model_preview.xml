	<panel name="left_panel">
		<panel name="model_name_representation_panel">
			<text name="name_label">モデル名:</text>
			<text name="model_category_label">このモデルは次を表します...</text>
			<line_editor name="description_form" />
			<combo_box name="model_category_combo">
				<combo_item name="Choose one">1つ選択...</combo_item>
				<combo_item name="Avatar shape">アバターシェイプ</combo_item>
				<combo_item name="Avatar attachment">アバターアタッチメント</combo_item>
				<combo_item name="Moving object (vehicle, animal)">動くオブジェクト（乗り物、動物）</combo_item>
				<combo_item name="Building Component">建物の部品</combo_item>
				<combo_item name="Large, non moving etc">大型の静止物など</combo_item>
				<combo_item name="Smaller, non-moving etc">小型の静止物など</combo_item>
				<combo_item name="Not really any of these">どれにも当てはまらない</combo_item>
			</combo_box>
		</panel>
		<tab_container name="import_tab">
			<panel name="lod_panel" label="詳細レベル" title="詳細レベル">
				<view_border name="lod_tab_border" />
				<text name="source">ソース</text>
				<text name="triangles">三角形</text>
				<text name="vertices">頂点</text>
				<text name="high_label">高</text>
				<combo_box name="lod_source_high">
					<combo_item name="Load from file">ファイルから読み込み</combo_item>
					<combo_item name="Generate">生成</combo_item>
				</combo_box>
				<line_editor name="lod_file_high" />
				<button name="lod_browse_high" label="参照..." />
				<combo_box name="lod_mode_high">
					<combo_item name="Triangle Limit">三角形数の上限</combo_item>
					<combo_item name="Error Threshold">誤差しきい値</combo_item>
				</combo_box>
				<spinner name="lod_triangle_limit_high" />
				<spinner name="lod_error_threshold_high" />
				<text name="high_triangles" />
				<text name="high_vertices" />
				<text name="high_status" />
				<icon name="status_icon_high" />
				<text name="medium_label">中</text>
				<combo_box name="lod_source_medium">
					<combo_item name="Load from file">ファイルから読み込み</combo_item>
					<combo_item name="Generate">生成</combo_item>
					<combo_item name="Use LoD above">上のLODを使用</combo_item>
				</combo_box>
				<line_editor name="lod_file_medium" />
				<button name="lod_browse_medium" label="参照..." />
				<combo_box name="lod_mode_medium">
					<combo_item name="Triangle Limit">三角形数の上限</combo_item>
					<combo_item name="Error Threshold">誤差しきい値</combo_item>
				</combo_box>
				<spinner name="lod_triangle_limit_medium" />
				<spinner name="lod_error_threshold_medium" />
				<text name="medium_triangles" />
				<text name="medium_vertices" />
				<text name="medium_status" />
				<icon name="status_icon_medium" />
				<text name="low_label">低</text>
				<combo_box name="lod_source_low">
					<combo_item name="Load from file">ファイルから読み込み</combo_item>
					<combo_item name="Generate">生成</combo_item>
					<combo_item name="Use LoD above">上のLODを使用</combo_item>
				</combo_box>
				<line_editor name="lod_file_low" />
				<button name="lod_browse_low" label="参照..." />
				<combo_box name="lod_mode_low">
					<combo_item name="Triangle Limit">三角形数の上限</combo_item>
					<combo_item name="Error Threshold">誤差しきい値</combo_item>
				</combo_box>
				<spinner name="lod_triangle_limit_low" />
				<spinner name="lod_error_threshold_low" />
				<text name="low_triangles" />
				<text name="low_vertices" />
				<text name="low_status" />
				<icon name="status_icon_low" />
				<text name="lowest_label">最低</text>
				<combo_box name="lod_source_lowest">
					<combo_item name="Load from file">ファイルから読み込み</combo_item>
					<combo_item name="Generate">生成</combo_item>
					<combo_item name="Use LoD above">上のLODを使用</combo_item>
