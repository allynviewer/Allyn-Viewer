				<text name="crease_label">折り目角度:</text>
				<spinner name="crease_angle" />
			</panel>
			<panel name="physics_panel" label="物理" title="物理">
				<view_border name="physics_tab_border" />
				<panel name="physics geometry">
					<text name="first_step_name">ステップ1: 詳細レベル</text>
					<combo_box name="physics_lod_combo" tool_tip="物理シェイプに使用するLOD">
						<combo_item name="choose_one">1つ選択...</combo_item>
						<combo_item name="physics_high">高</combo_item>
						<combo_item name="physics_medium">中</combo_item>
						<combo_item name="physics_low">低</combo_item>
						<combo_item name="physics_lowest">最低</combo_item>
						<combo_item name="load_from_file">ファイルから</combo_item>
					</combo_box>
					<line_editor name="physics_file" />
					<button name="physics_browse" label="参照..." />
				</panel>
				<view_border name="physics_tab_border" />
				<panel name="physics analysis">
					<text name="method_label">ステップ2: 分析</text>
					<text name="analysis_method_label">方法:</text>
					<text name="quality_label">品質:</text>
					<text name="smooth_method_label">スムーズ:</text>
					<combo_box name="Method" />
					<combo_box name="Decompose Quality" />
					<combo_box name="Cosine%" />
					<check_box name="Close Holes (Slow)" label="穴を閉じる" />
					<button name="Decompose" label="分析" />
					<button name="decompose_cancel" label="キャンセル" />
				</panel>
				<view_border name="physics_tab_border2" />
				<panel name="physics simplification">
					<text name="second_step_label">ステップ3: 簡略化</text>
					<text name="simp_method_header">方法:</text>
					<text name="pass_method_header">パス数:</text>
					<text name="Detail Scale label">詳細スケール:</text>
					<text name="Retain%_label">保持:</text>
					<combo_box name="Simplify Method" />
					<combo_box name="Combine Quality" />
					<spinner name="Detail Scale" />
					<spinner name="Retain%" />
					<button name="Simplify" label="簡略化" />
					<button name="simplify_cancel" label="キャンセル" />
				</panel>
				<view_border name="physics_tab_border3" />
				<panel name="physics info">
					<text name="results_text">結果:</text>
					<text name="physics_triangles">三角形: [TRIANGLES],</text>
					<text name="physics_points">頂点: [POINTS],</text>
					<text name="physics_hulls">ハル: [HULLS]</text>
				</panel>
			</panel>
			<panel name="modifiers_panel" label="アップロードオプション" title="アップロードオプション">
				<view_border name="modifiers_tab_border" />
				<text name="scale_label">スケール（1 = スケールなし）:</text>
				<spinner name="import_scale" />
				<text name="dimensions_label">寸法:</text>
				<text name="import_dimensions">[X] X [Y] X [Z]</text>
				<check_box name="upload_textures" label="テクスチャを含める" />
				<view_border name="modifiers_tab_border2" />
				<text name="include_label">アバターモデルのみ:</text>
				<check_box name="upload_skin" label="スキンウェイトを含める" />
				<text name="pelvis_offset_label">Zオフセット（アバターを上げる／下げる）:</text>
				<spinner name="pelvis_offset" />
				<check_box name="upload_joints" label="ジョイント位置を含める" />
			</panel>
		</tab_container>
		<panel name="weights_and_warning_panel">
			<button name="calculate_btn" label="ウェイトと手数料を計算" tool_tip="ウェイトと手数料を計算" />
			<button name="cancel_btn" label="キャンセル" />
			<button name="ok_btn" label="アップロード" tool_tip="シミュレーターにアップロード" />
			<button name="reset_btn" label="設定をクリアしてフォームをリセット" />
			<text name="upload_fee">アップロード手数料: [CURRENCY] [FEE]</text>
			<text name="prim_weight">土地インパクト: [EQ]</text>
			<text name="download_weight">ダウンロード: [ST]</text>
			<text name="physics_weight">物理: [PH]</text>
			<text name="server_weight">サーバー: [SIM]</text>
			<text name="price_breakdown">価格内訳: ストリーミング: [CURRENCY] [STREAMING] 物理: [CURRENCY] [PHYSICS] インスタンス: [CURRENCY] [INSTANCES] テクスチャ: [CURRENCY] [TEXTURES] モデル: [CURRENCY] [MODEL]</text>
			<text name="warning_title">注記:</text>
			<text name="warning_message">メッシュモデルをアップロードする権限がありません。</text>
			<text name="validate_url">認定の取得方法はこちらをクリック</text>
			<text name="status">[STATUS]</text>
		</panel>
	</panel>
	<text name="lod_label">プレビュー:</text>
	<panel name="preview_panel" />
	<panel name="right_panel">
		<combo_box name="preview_lod_combo" tool_tip="プレビューに表示するLOD">
			<combo_item name="high">高</combo_item>
			<combo_item name="medium">中</combo_item>
			<combo_item name="low">低</combo_item>
			<combo_item name="lowest">最低</combo_item>
		</combo_box>
		<text name="label_display">表示...</text>
		<check_box name="show_edges" label="辺" />
		<check_box name="show_physics" label="物理" />
		<check_box name="show_textures" label="テクスチャ" />
		<check_box name="show_skin_weight" label="スキンウェイト" />
		<check_box name="show_joint_positions" label="ジョイント" />
		<text name="physics_explode_label">プレビューの展開:</text>
		<slider name="physics_explode" />
	</panel>
</floater>
