<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="chat floater" title="ローカルチャット">
	<string name="ringing">ワールド内ボイスチャットに接続中...</string>
	<string name="connected">接続済み</string>
	<string name="unavailable">現在地ではボイスを利用できません</string>
	<string name="hang_up">ワールド内ボイスチャットから切断しました</string>
	<string name="voice_icon">icn_voice-localchat.tga</string>
	<string name="IM_logging_string">-- ログ記録を開始 --</string>
	<string name="IM_end_log_string">-- ログ終了 --</string>
	<layout_stack name="panels">
		<layout_panel name="im_contents_panel">
			<layout_stack name="im_contents_stack">
				<layout_panel name="history_panel">
					<combo_box name="Gesture" label="ジェスチャー">
						<combo_item name="Gestures">ジェスチャー</combo_item>
					</combo_box>
					<check_box name="show mutes" label="ミュートしたテキストを表示" />
					<button name="chat_history_open" label="履歴を開く" tool_tip="クリックするとチャット履歴を外部エディタで開きます。" />
					<button name="toggle_active_speakers_btn" label="&lt; &lt;" tool_tip="クリックすると、このIMセッションの参加者リストを表示します。" />
					<text_editor name="Chat History Editor" />
					<text_editor name="Chat History Editor with mute" />
				</layout_panel>
				<layout_panel name="chat_layout_panel">
					<panel name="chat_panel">
						<string name="gesture_label">ジェスチャー</string>
						<line_editor name="Chat Editor" label="クリックしてチャット" />
						<flyout_button name="Say" label="発言" tool_tip="（Enter）">
							<flyout_button_item name="shout_item">シャウト</flyout_button_item>
							<flyout_button_item name="say_item">発言</flyout_button_item>
							<flyout_button_item name="whisper_item">ささやき</flyout_button_item>
						</flyout_button>
					</panel>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="active_speakers_panel" />
	</layout_stack>
</floater>
