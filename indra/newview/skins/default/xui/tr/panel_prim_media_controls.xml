<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="MediaControls">
	<string name="control_background_image_name">square_btn_32x128.tga</string>
	<string name="skip_step" />
	<string name="min_width" />
	<string name="min_height" />
	<string name="zoom_near_padding" />
	<string name="zoom_medium_padding" />
	<string name="zoom_far_padding" />
	<string name="top_world_view_avoid_zone" />
	<layout_stack name="progress_indicator_area">
		<layout_panel name="left_bookend_bottom" />
		<layout_panel name="media_progress_indicator">
			<progress_bar name="media_progress_bar" tool_tip="Medya Yükleniyor" />
		</layout_panel>
		<layout_panel name="right_bookend_bottom" />
	</layout_stack>
	<layout_stack name="media_controls">
		<layout_panel name="left_bookend" />
		<layout_panel name="back">
			<button name="back_btn" tool_tip="Geri git" />
		</layout_panel>
		<layout_panel name="fwd">
			<button name="fwd_btn" tool_tip="İleriye git" />
		</layout_panel>
		<layout_panel name="home">
			<button name="home_btn" tool_tip="Ana sayfa" />
		</layout_panel>
		<layout_panel name="media_stop">
			<button name="media_stop_btn" tool_tip="Medyayı durdur" />
		</layout_panel>
		<layout_panel name="reload">
			<button name="reload_btn" tool_tip="Yeniden yükle" />
		</layout_panel>
		<layout_panel name="stop">
			<button name="stop_btn" tool_tip="Yüklemeyi durdur" />
		</layout_panel>
		<layout_panel name="play">
			<button name="play_btn" tool_tip="Medyayı oynat" />
		</layout_panel>
		<layout_panel name="pause">
			<button name="pause_btn" tool_tip="Medyayı duraklat" />
		</layout_panel>
		<layout_panel name="media_address">
			<line_editor name="media_address_url" tool_tip="Medya URL'si" />
			<layout_stack name="media_address_url_icons">
				<layout_panel>
					<icon name="media_whitelist_flag" tool_tip="White List enabled" />
				</layout_panel>
				<layout_panel>
					<icon name="media_secure_lock_flag" tool_tip="Güvenli Tarama" />
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="media_play_position">
			<slider_bar name="media_play_slider" tool_tip="Film oynatma ilerlemesi" />
		</layout_panel>
		<layout_panel name="skip_back">
			<button name="skip_back_btn" tool_tip="Geri adım atın" />
		</layout_panel>
		<layout_panel name="skip_forward">
			<button name="skip_forward_btn" tool_tip="İleri adım atın" />
		</layout_panel>
		<layout_panel name="media_volume">
			<button name="media_mute_button" tool_tip="Bu Medyanın Sesini Kapat" />
			<slider name="volume_slider" tool_tip="Medya Sesi" />
		</layout_panel>
		<layout_panel name="moap_stop">
			<button name="stop_btn" tool_tip="Medyayı durdur" />
		</layout_panel>
		<layout_panel name="zoom_frame">
			<button name="zoom_frame_btn" tool_tip="Medyayı yakınlaştırın" />
		</layout_panel>
		<layout_panel name="close">
			<button name="close_btn" tool_tip="Geri Yakınlaştır" />
		</layout_panel>
		<layout_panel name="new_window">
			<button name="new_window_btn" tool_tip="URL'yi tarayıcıda aç" />
		</layout_panel>
		<layout_panel name="right_bookend" />
	</layout_stack>
	<panel name="media_region" />
</panel>
