		<button name="take_objects" label="Al" />
		<button name="take_copy_objects" label="Kopyasını al" />
		<button name="teleport_me_to_object" label="Beni ona ışınla" tool_tip="Yalnızca bir karakter seçildiğinde etkinleştirilir." />
		<button name="return_objects" label="Dönüş" />
		<button name="delete_objects" label="Sil" />
