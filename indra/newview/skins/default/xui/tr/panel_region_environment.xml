<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_env_info" label="Çevre">
	<text name="water_settings_title">
		Tüm ziyaretçilerin sitenize gelmesini istediğiniz Su ve Gökyüzü/Gün Döngüsü Ayarlarını seçin.
görülmesi gereken bölge.  Daha fazla bilgi
	</text>
	<view_border name="border" />
	<radio_group name="region_settings_radio_group">
		<radio_item name="use_sl_default_settings">Second Life varsayılanını kullan</radio_item>
		<radio_item name="use_my_settings">Aşağıdaki ayarları kullanın</radio_item>
	</radio_group>
	<panel name="user_environment_settings">
		<text name="water_settings_title">Su Ayarı</text>
		<combo_box name="water_settings_preset_combo">
			<combo_item name="item0">-Bir ön ayar seçin-</combo_item>
		</combo_box>
		<text name="sky_dayc_settings_title">Gökyüzü / Gün Döngüsü</text>
		<radio_group name="sky_dayc_settings_radio_group">
			<radio_item name="my_sky_settings">Sabit gökyüzü</radio_item>
			<radio_item name="my_dayc_settings">Gün döngüsü</radio_item>
		</radio_group>
		<combo_box name="sky_settings_preset_combo">
			<combo_item name="item0">-Bir ön ayar seçin-</combo_item>
		</combo_box>
		<combo_box name="dayc_settings_preset_combo">
			<combo_item name="item0">-Bir ön ayar seçin-</combo_item>
		</combo_box>
	</panel>
	<button name="apply_btn" label="Uygula" />
	<button name="cancel_btn" label="İptal" />
	<text name="progress_indicator">Applying</text>
</panel>
