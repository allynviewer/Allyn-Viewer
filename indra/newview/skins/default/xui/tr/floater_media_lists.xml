<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="floatermedialists" title="Medya Filtresi">
	<floater.string name="EnterUrlAllow">Her zaman izin verilecek etki alanını veya URL'yi girin:</floater.string>
	<floater.string name="EnterUrlDeny">Hiçbir zaman izin verilmeyecek etki alanını veya URL'yi girin:</floater.string>
	<layout_stack name="lists_layout_stack">
		<layout_panel name="whitelist_layout_panel">
			<scroll_list name="whitelist">
				<column name="list" label="İzin Verilen Alanlar" />
			</scroll_list>
			<layout_stack name="whitelist_buttons_layout_stack">
				<layout_panel name="whitelist_buttons_panel_add">
					<button name="add_whitelist" label="Ekle..." />
				</layout_panel>
				<layout_panel name="whitelist_buttons_panel_remove">
					<button name="remove_whitelist" label="Kaldır" />
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="blacklist_layout_panel">
			<scroll_list name="blacklist">
				<column name="list" label="Engellenen Alanlar" />
			</scroll_list>
			<layout_stack name="blacklist_buttons_layout_stack">
				<layout_panel name="blacklist_buttons_panel_add">
					<button name="add_blacklist" label="Ekle..." />
				</layout_panel>
				<layout_panel name="blacklist_buttons_panel_remove">
					<button name="remove_blacklist" label="Kaldır" />
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</floater>
