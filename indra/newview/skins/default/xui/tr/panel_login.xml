<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<string name="online_users_title">ÇEVRİMİÇİ KULLANICILAR</string>
	<string name="online_allyn_label">ALLYN VIEWER</string>
	<string name="online_sl_label">SECOND LIFE</string>
	<panel name="login_form_bg">
		<scroll_container name="login_form_scroll">
			<panel name="login_form_inner">
				<panel name="online_users_panel">
					<text name="online_users_title">ÇEVRİMİÇİ KULLANICILAR</text>
				</panel>
				<text name="login_title">ALLYN VIEWER</text>
				<text name="login_subtitle">Devam etmek için giriş yapın</text>
				<text name="name_label">Kullanıcı adı</text>
				<text name="password_text">Şifre</text>
				<panel name="location_panel">
					<text name="start_location_text">Başlangıç Konumu</text>
					<combo_box name="start_location_combo">
						<combo_item name="MyHome">Evim</combo_item>
						<combo_item name="MyLastLocation">Son Konumum</combo_item>
						<combo_item name="Typeregionname">&lt;bölge&gt;</combo_item>
					</combo_box>
				</panel>
				<button label="Giriş Yap" label_selected="Giriş Yap" name="connect_btn"/>
				<check_box label="Kullanıcı adını kaydet" name="remember_name_check"/>
				<button name="remove_login" tool_tip="Seçili kayıtlı giriş bilgisini sil"/>
				<check_box label="Şifreyi kaydet" name="remember_check"/>
				<text name="create_new_account_text">Hesap oluştur</text>
				<text name="forgot_password_text">Adınızı veya şifrenizi mi unuttunuz?</text>
				<panel name="grids_panel">
					<text name="grids_combo_text">Grid veya Giriş URI:</text>
					<combo_box name="grids_combo" tool_tip="Bilinen bir grid adı veya giriş URI'si girin"/>
					<button name="grids_btn" label="Grid Yöneticisi"/>
				</panel>
			</panel>
		</scroll_container>
	</panel>
</panel>
