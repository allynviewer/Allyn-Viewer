<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<mimetypes name="default">
	<defaultlabel>(Bilinmiyor)</defaultlabel>
	<defaultwidget>hiçbiri</defaultwidget>
	<defaultimpl>media_plugin_cef</defaultimpl>
	<widgetset name="web">
		<label name="web_label">Web İçeriği</label>
		<icon>icn_media_web.tga</icon>
		<default_type>text/html</default_type>
		<tooltip name="web_tooltip">Bu konumda Web içeriği var</tooltip>
		<playtip name="web_playtip">Web içeriğini göster</playtip>
		<allow_resize>true</allow_resize>
		<allow_looping>false</allow_looping>
	</widgetset>
	<widgetset name="movie">
		<label name="movie_label">Film</label>
		<default_type>video/*</default_type>
		<icon>icn_media_movie.tga</icon>
		<tooltip name="movie_tooltip">Burada oynayacak bir film var</tooltip>
		<playtip name="movie_playtip">Filmi oynat</playtip>
		<allow_resize>false</allow_resize>
		<allow_looping>true</allow_looping>
	</widgetset>
	<widgetset name="image">
		<label name="image_label">Resim</label>
		<icon>icn_media_web.tga</icon>
		<default_type>image/*</default_type>
		<tooltip name="image_tooltip">Bu konumda bir resim var</tooltip>
		<playtip name="image_playtip">Bu konumun resmini görüntüle</playtip>
		<allow_resize>false</allow_resize>
		<allow_looping>false</allow_looping>
	</widgetset>
	<widgetset name="audio">
		<label name="audio_label">Ses</label>
		<icon>icn_media_web.tga</icon>
		<default_type>audio/*</default_type>
		<tooltip name="audio_tooltip">Bu konumda ses var</tooltip>
		<playtip name="audio_playtip">Bu konumun sesini çal</playtip>
		<allow_resize>false</allow_resize>
		<allow_looping>true</allow_looping>
	</widgetset>
	<widgetset name="none">
		<label name="none_label">No Content</label>
		<default_type>hiçbiri / hiçbiri</default_type>
		<icon>icn_media_web.tga</icon>
		<tooltip name="none_tooltip">No media here</tooltip>
		<playtip name="none_playtip" />
		<allow_resize>false</allow_resize>
		<allow_looping>false</allow_looping>
	</widgetset>
	<scheme name="rtsp">
		<label name="rtsp_label">Gerçek Zamanlı Akış</label>
		<widgettype>movie</widgettype>
		<impl>media_plugin_libvlc</impl>
	</scheme>
