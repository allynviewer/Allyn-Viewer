			<button name="earlier_details_button" label="&lt; Daha önce" tool_tip="Zamanda geriye git" />
			<button name="later_details_button" label="Daha sonra &gt;" tool_tip="Zamanda ileri git" />
		</panel>
		<panel name="group_money_sales_tab" label="Satış">
			<text_editor name="group_money_sales_text">Bilgisayar...</text_editor>
			<button name="earlier_sales_button" label="&lt; Daha önce" tool_tip="Zamanda geriye git" />
			<button name="later_sales_button" label="Daha sonra &gt;" tool_tip="Zamanda ileri git" />
		</panel>
	</tab_container>
</panel>
