	<line_editor name="to_form" />
	<text name="from_label">E-postanız:</text>
	<line_editor name="from_form" />
	<text name="name_label">Adınız:</text>
	<line_editor name="name_form" />
	<text name="subject_label">Konu:</text>
	<line_editor name="subject_form" label="Konunuzu buraya yazın." />
