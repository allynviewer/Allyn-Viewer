<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="translation" label="Çeviri">
	<tab_container name="translation_tabs" label="Çeviri">
		<panel name="General" label="General">
			<check_box name="enable_check" label="AI çevirisini etkinleştir" />
			<text name="scope_label">Uygula:</text>
			<combo_box name="scope_combo">
				<combo_item name="im">Yalnızca IM</combo_item>
				<combo_item name="nearby">Yakın sohbet</combo_item>
				<combo_item name="both">İkisi</combo_item>
			</combo_box>
			<check_box name="incoming_check" label="Geleni çevir" />
			<check_box name="outgoing_check" label="Gidenleri çevir" />
			<text name="src_label">Dilim:</text>
			<combo_box name="source_lang" tool_tip="Herhangi bir ISO kodu (pt, en, ja, ru, zh...). Özel bir kod yazabilirsiniz.">
				<combo_item name="pt">Portekizce (pt)</combo_item>
				<combo_item name="en">İngilizce (en)</combo_item>
				<combo_item name="es">İspanyolca (es)</combo_item>
				<combo_item name="fr">Fransızca (fr)</combo_item>
				<combo_item name="de">Almanca (de)</combo_item>
				<combo_item name="it">İtalyanca (it)</combo_item>
				<combo_item name="ru">Rusça (ru)</combo_item>
				<combo_item name="ja">Japonca (ja)</combo_item>
				<combo_item name="ko">Korece (ko)</combo_item>
				<combo_item name="zh">Çince (zh)</combo_item>
				<combo_item name="ar">Arapça (ar)</combo_item>
				<combo_item name="nl">Felemenkçe</combo_item>
				<combo_item name="pl">Lehçe (pl)</combo_item>
				<combo_item name="tr">Türkçe (tr)</combo_item>
				<combo_item name="hi">Hintçe (hi)</combo_item>
				<combo_item name="th">Tayca</combo_item>
				<combo_item name="vi">Vietnamca (vi)</combo_item>
				<combo_item name="uk">Ukraynaca</combo_item>
			</combo_box>
			<text name="dst_label">Diğer dil:</text>
			<combo_box name="target_lang" tool_tip="Herhangi bir ISO kodu. Diliniz listede yoksa serbestçe yazın.">
				<combo_item name="en">İngilizce (en)</combo_item>
				<combo_item name="pt">Portekizce (pt)</combo_item>
				<combo_item name="es">İspanyolca (es)</combo_item>
				<combo_item name="fr">Fransızca (fr)</combo_item>
				<combo_item name="de">Almanca (de)</combo_item>
				<combo_item name="it">İtalyanca (it)</combo_item>
				<combo_item name="ru">Rusça (ru)</combo_item>
				<combo_item name="ja">Japonca (ja)</combo_item>
				<combo_item name="ko">Korece (ko)</combo_item>
				<combo_item name="zh">Çince (zh)</combo_item>
				<combo_item name="ar">Arapça (ar)</combo_item>
				<combo_item name="nl">Felemenkçe</combo_item>
				<combo_item name="pl">Lehçe (pl)</combo_item>
				<combo_item name="tr">Türkçe (tr)</combo_item>
				<combo_item name="hi">Hintçe (hi)</combo_item>
				<combo_item name="th">Tayca</combo_item>
				<combo_item name="vi">Vietnamca (vi)</combo_item>
				<combo_item name="uk">Ukraynaca</combo_item>
			</combo_box>
			<text name="in_disp_label">Gelen:</text>
			<combo_box name="incoming_display">
				<combo_item name="translation_only">Yalnızca çeviri (orijinali gizle)</combo_item>
				<combo_item name="both">Orijinal ve çeviri</combo_item>
			</combo_box>
			<text name="out_disp_label">Giden:</text>
			<combo_box name="outgoing_display">
				<combo_item name="translation_only">Yalnızca çeviri (orijinali gizle)</combo_item>
				<combo_item name="both">Orijinal ve çeviri</combo_item>
			</combo_box>
			<text name="in_color_label">Gelen renk:</text>
			<color_swatch name="incoming_color" />
			<text name="out_color_label">Giden renk:</text>
			<color_swatch name="outgoing_color" />
			<text name="privacy_tip">Ben konuşuyorum / Diğerleri konuşuyor = herhangi bir dil (ISO kodunu seçin veya yazın: ja, ru, zh...). Giden: siz → diğerleri. Gelen: diğerleri→siz. [IA] yalnızca gelenlerde. Metin zaten hedef dildeyse yinelenen satır yoktur.</text>
		</panel>
		<panel name="Groups" label="Gruplar">
			<check_box name="groups_enable" label="Grup sohbetlerini tercüme et" />
			<text name="group_mode_label">Gruplar:</text>
			<combo_box name="group_mode">
				<combo_item name="all">Tüm gruplarım</combo_item>
				<combo_item name="selected">Aşağıdakiler</combo_item>
			</combo_box>
			<scroll_list name="group_list" tool_tip="Birden çok grubu seçmek için Ctrl+tıklama (Seçili mod)">
				<column name="name" label="Grup" />
			</scroll_list>
			<button name="group_refresh_btn" label="Grupları yenile" />
		</panel>
		<panel name="Provider" label="Sağlayıcı">
			<text name="provider_label">Sağlayıcı:</text>
			<combo_box name="provider_combo">
				<combo_item name="openai">OpenAI (ChatGPT)</combo_item>
				<combo_item name="anthropic">Anthropic (Claude)</combo_item>
				<combo_item name="opencode_zen">OpenCode Zen</combo_item>
				<combo_item name="openrouter">OpenRouter</combo_item>
				<combo_item name="custom">Özel (OpenAI uyumlu)</combo_item>
			</combo_box>
			<text name="key_label">API anahtarı:</text>
			<line_editor name="api_key" />
			<text name="url_label">Temel URL:</text>
			<line_editor name="base_url" />
			<text name="model_label">Model:</text>
			<line_editor name="model" />
			<button name="test_btn" label="Bağlantıyı test et" />
			<text name="status_text">Test edilmedi</text>
			<text name="provider_tip">API anahtarı yerel ayarlarda saklanır (yalnızca bu bilgisayarda).&#10;OpenCode Zen: chat/completions (ör. mimo-v2.5-free).&#10;OpenRouter: https://openrouter.ai/api/v1 (ör. minimax/minimax-m3:free).</text>
		</panel>
	</tab_container>
</panel>
