<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="floatermedialists" title="Medienfilter">
	<floater.string name="EnterUrlAllow">Domain oder URL eingeben, die immer erlaubt werden soll:</floater.string>
	<floater.string name="EnterUrlDeny">Domain oder URL eingeben, die nie erlaubt werden soll:</floater.string>
	<layout_stack name="lists_layout_stack">
		<layout_panel name="whitelist_layout_panel">
			<scroll_list name="whitelist">
				<column name="list" label="Erlaubte Domains"/>
			</scroll_list>
			<layout_stack name="whitelist_buttons_layout_stack">
				<layout_panel name="whitelist_buttons_panel_add">
					<button name="add_whitelist" label="Hinzufügen..."/>
				</layout_panel>
				<layout_panel name="whitelist_buttons_panel_remove">
					<button name="remove_whitelist" label="Entfernen"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="blacklist_layout_panel">
			<scroll_list name="blacklist">
				<column name="list" label="Blockierte Domains"/>
			</scroll_list>
			<layout_stack name="blacklist_buttons_layout_stack">
				<layout_panel name="blacklist_buttons_panel_add">
					<button name="add_blacklist" label="Hinzufügen..."/>
				</layout_panel>
				<layout_panel name="blacklist_buttons_panel_remove">
					<button name="remove_blacklist" label="Entfernen"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</floater>
