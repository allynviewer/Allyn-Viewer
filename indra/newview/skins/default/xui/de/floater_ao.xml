<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="geminifloater" title="AO-Einstellungen">
	<drop_target name="ao_notecard" label="ZHAO-Notecard hierher ziehen" tool_tip="ZHAO-Notecard hierher ziehen. Animationen müssen im selben Inventarordner liegen."/>
	<button name="opencard" label="" tool_tip="Aktuelle AO-Notecard anzeigen"/>
	<button name="reloadcard" label="" tool_tip="Animationen aus der AO-Notecard neu laden"/>
	<button name="newcard" label="" tool_tip="Neue AO-Notecard-Vorlage im Inventar erstellen"/>
	<check_box name="AOEnabled" label="Animations-Override aktivieren" tool_tip="Animation Overrider ein- oder ausschalten"/>
	<check_box name="AOSwimEnabled" label="Schwimm-Override aktivieren" tool_tip="Fluganimationen unter Wasser durch Schwimmunimationen ersetzen"/>
	<check_box name="AOSitsEnabled" label="Sitz-Override aktivieren" tool_tip="Sitz- und Bodensitzanimationen überschreiben"/>
	<text name="buttons_desc">Stände:</text>
	<combo_box name="stands" tool_tip="Aktuelle Stand-Animation"/>
	<button name="prevstand" label="" tool_tip="Vorheriger Stand"/>
	<button name="nextstand" label="" tool_tip="Nächster Stand"/>
	<check_box name="AOStandRandomize" label="Stand-Reihenfolge zufällig" tool_tip="Stände zufällig statt nacheinander wechseln"/>
