	<check_box name="ao_remote_checkbox" label="AO-Toolbar anzeigen" tool_tip="AO-Fernbedienung in der unteren Toolbar anzeigen"/>
	<spinner name="standtime" label="Standzeit:" tool_tip="Dauer jedes Stands in Sekunden"/>
	<button name="more_btn" label="Mehr &gt;&gt;" label_selected="&lt;&lt; Weniger" tool_tip="Standard-Animationen ein- oder ausblenden"/>
	<tab_container name="tabcontainer" label="Standard">
		<panel name="tabdefaultanims" label="Standard-Anims">
