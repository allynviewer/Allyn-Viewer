			<spinner label="Std." name="WLLengthOfDayHour"/>
			<spinner label="Min." name="WLLengthOfDayMin"/>
			<spinner label="Sek." name="WLLengthOfDaySec"/>
			<text name="DayCycleText3">Vorschau:</text>
			<button label="Abspielen" label_selected="Abspielen" name="WLAnimSky"/>
			<button label="Stopp" label_selected="Stopp" name="WLStopAnimSky"/>
			<button label="Grundstückszeit" label_selected="Zur Grundstückszeit" name="WLUseLindenTime"/>
			<text name="KeyFramePresetsText">Voreinstellungen:</text>
			<button label="Neu" label_selected="Neu" name="DayCycleNewPreset"/>
			<button label="Speichern" label_selected="Speichern" name="DayCycleSavePreset"/>
			<button label="Löschen" label_selected="Löschen" name="DayCycleDeletePreset"/>
