<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<string name="online_users_title">BENUTZER ONLINE</string>
	<string name="online_allyn_label">ALLYN VIEWER</string>
	<string name="online_sl_label">SECOND LIFE</string>
	<panel name="login_form_bg">
		<scroll_container name="login_form_scroll">
			<panel name="login_form_inner">
				<panel name="online_users_panel">
					<text name="online_users_title">BENUTZER ONLINE</text>
				</panel>
				<text name="login_title">ALLYN VIEWER</text>
				<text name="login_subtitle">Anmelden zum Fortfahren</text>
				<text name="name_label">Benutzername</text>
				<text name="password_text">Passwort</text>
				<panel name="location_panel">
					<text name="start_location_text">Startposition</text>
					<combo_box name="start_location_combo">
						<combo_item name="MyHome">Mein Heim</combo_item>
						<combo_item name="MyLastLocation">Letzter Standort</combo_item>
						<combo_item name="Typeregionname">&lt;Region eingeben&gt;</combo_item>
					</combo_box>
				</panel>
				<button label="Anmelden" label_selected="Anmelden" name="connect_btn"/>
				<check_box label="Benutzername speichern" name="remember_name_check"/>
				<button name="remove_login" tool_tip="Gespeicherten Login löschen"/>
				<check_box label="Passwort speichern" name="remember_check"/>
				<text name="create_new_account_text">Konto erstellen</text>
				<text name="forgot_password_text">Passwort vergessen?</text>
				<panel name="grids_panel">
					<text name="grids_combo_text">Grid oder Login-URI:</text>
					<combo_box name="grids_combo" tool_tip="Grid-Name oder Login-URI"/>
					<button name="grids_btn" label="Grid-Manager"/>
				</panel>
			</panel>
		</scroll_container>
	</panel>
</panel>
