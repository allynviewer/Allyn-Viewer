<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel border="true" bottom="-409" height="408" label="Netzwerk" left="102" name="network" width="517">
	<scroll_container name="network_scroll">
		<panel name="network_scroll_inner">
			<text bottom="-20" follows="top" height="10" left="12" name="text_box">Maximale Bandbreite:</text>
			<slider bottom_delta="-4" left_delta="110" can_edit_text="true" decimal_digits="0" follows="top" height="15" increment="10" initial_val="50" max_val="10000" min_val="50" name="max_bandwidth" show_text="true" value="500" width="180" />
			<text bottom_delta="4" follows="top" height="10" left_delta="186" name="text_box2">kbit/s (Kilobit pro Sekunde)</text>
			<text bottom_delta="-20" follows="top" height="10" left="12" name="text_box3">Textur-Bandbreite:</text>
			<slider bottom_delta="-4" left_delta="110" can_edit_text="true" decimal_digits="0" follows="top" height="15" increment="10" initial_val="50" max_val="10000" min_val="50" name="tex_bandwidth" show_text="true" value="500" width="180" />
			<text bottom_delta="4" follows="top" height="10" left_delta="186" name="text_box4">kbit/s (Kilobit pro Sekunde)</text>
			<text bottom_delta="-25" follows="top" height="10" left="12" name="use_http_for" visible="false">HTTP verwenden für:</text>
			<check_box bottom_delta="-5" follows="top" left_delta="90" label="Texturen" name="http_textures" visible="false" />
			<check_box bottom_delta="0" follows="top" left_delta="90" label="Inventar" name="http_inventory" visible="false" />
			<text bottom_delta="-20" follows="top" height="10" left="12" name="cache_size_label_l">Festplatten-Cache-Größe:</text>
			<slider bottom_delta="-4" left_delta="110" can_edit_text="true" decimal_digits="0" follows="top" height="15" increment="64" initial_val="1024" max_val="9984" min_val="64" name="cache_size" show_text="true" width="180" />
			<text bottom_delta="4" follows="top" height="10" left_delta="186" name="text_box5">MB</text>
			<button bottom_delta="-8" follows="top" height="22" label="Cache leeren" left_delta="30" name="clear_cache" scale_image="true" width="100" />
			<text bottom_delta="-17" follows="top" height="10" left="12" name="cache_location_label">Festplatten-Cache-Verzeichnis:</text>
			<line_editor bevel_style="in" border_style="line" border_thickness="1" bottom_delta="-28" follows="top" handle_edit_keys_directly="true" height="20" left_delta="7" max_length="4096" name="cache_location" width="470" />
			<button bottom_delta="-25" follows="top" height="22" label="Festlegen" label_selected="Festlegen" name="set_cache" scale_image="true" width="100" />
			<button bottom_delta="0" follows="top" height="22" label="Zurücksetzen" label_selected="Zurücksetzen" left_delta="103" name="reset_cache" scale_image="true" width="100" />
			<check_box bottom_delta="-35" follows="top" height="16" initial_value="false" label="Benutzerdefinierter Port" left="12" name="connection_port_enabled" />
			<spinner bottom_delta="-20" decimal_digits="0" follows="top" height="16" increment="1" initial_val="13000" label="Portnummer:" label_width="75" left_delta="20" max_val="65535" min_val="0" name="connection_port" width="150" />
			<text bottom_delta="-24" follows="top" height="10" left="12" name="socks5_auth_label">HTTP-Proxy:</text>
			<radio_group bottom_delta="-8" draw_border="false" follows="left|top" height="20" left="12" name="socks5_http_proxy_type" width="380">
				<radio_item height="20" bottom="0" left="100" name="None" width="50" tool_tip="Kein HTTP-Proxy">Kein</radio_item>
				<radio_item height="20" bottom="0" left="170" name="Socks" width="50" tool_tip="Socks für HTTP-Proxy verwenden">Socks</radio_item>
				<radio_item height="20" bottom="0" left="250" name="Web" width="50" tool_tip="Web-Proxy für HTTP verwenden">Web</radio_item>
			</radio_group>
			<check_box bottom_delta="-24" follows="top" height="16" initial_value="false" label="SOCKS 5 Proxy aktivieren" left="6" mouse_opaque="true" name="socks5_proxy_enabled" radio_style="false" width="256" />
			<text bottom_delta="-26" follows="top" height="10" left="12" name="socks5_host_label">Socks 5 Host:</text>
			<line_editor bottom_delta="-6" follows="top" font="SansSerif" height="20" left="90" name="socks5_proxy_host" tool_tip="Name oder IP-Adresse des gewünschten SOCKS5-Proxys" width="311" />
			<spinner bottom_delta="-30" decimal_digits="0" follows="top" height="16" increment="1" initial_val="80" label="Portnummer:" label_width="75" max_val="65535" min_val="0" name="socks5_proxy_port" width="140" />
			<text bottom_delta="-20" follows="top" height="10" left="12" name="socks5_auth_label2">Socks5-Authentifizierung:</text>
			<radio_group bottom_delta="-6" draw_border="false" follows="top" height="20" name="socks5_auth" width="420">
				<radio_item bottom="0" height="20" left_delta="80" name="None" tool_tip="Keine Authentifizierung">Keine</radio_item>
				<radio_item bottom="0" height="20" left_delta="50" name="UserPass" tool_tip="Username/Passwort-Authentifizierung">Username/Passwort</radio_item>
			</radio_group>
			<text bottom_delta="-22" follows="top" height="10" left="12" name="socks5_username_label">Username:</text>
			<line_editor bottom_delta="-8" follows="top" font="SansSerif" height="20" left="90" name="socks5_proxy_username" tool_tip="Username für den SOCKS5-Proxy" width="311" />
			<text bottom_delta="-20" follows="top" height="10" left="12" name="socks5_password_label">Passwort:</text>
			<line_editor bottom_delta="-8" follows="top" font="SansSerif" height="20" left="90" name="socks5_proxy_password" tool_tip="Passwort für den SOCKS5-Proxy" width="311" />
		</panel>
	</scroll_container>
</panel>
