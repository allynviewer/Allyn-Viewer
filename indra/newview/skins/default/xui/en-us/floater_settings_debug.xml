<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater can_close="true" can_drag_on_left="false" can_minimize="false"
     can_resize="true" height="340" name="settings_debug" min_height="270" min_width="360"
     title="Debug Settings" width="380" rect_control="FloaterDebugSettingsRect">
    <filter_editor bottom="-54" follows="top|left|right" height="20" left="12" right="-12" max_length="1024" name="search_settings_input" tool_tip="Type the search term you are interested in here. Results will be displayed for partial fulltext matches within the setting's name or comment.">
        <filter_editor.commit_callback function="UpdateFilter"/>
    </filter_editor>
    <scroll_list bottom="170" follows="all" height="110" left="12" right="-12" name="settings_scroll_list">
        <scroll_list.commit_callback function="SettingSelect"/>
    </scroll_list>
	<text_editor follows="left|right|bottom" bottom="104" enabled="false" height="60" left="12" right="-12" hide_scrollbar="true"
	     name="comment_text" word_wrap="true" hide_border="true" />
	<radio_group bottom="60" draw_border="false" follows="bottom|left|right" height="36"
	     left="16" name="boolean_combo" visible="false">
		<radio_item bottom="-18" height="15" name="TRUE" value="TRUE">
			True
		</radio_item>
		<radio_item bottom="-36" height="15" name="FALSE" value="FALSE">
			False
		</radio_item>
		<radio_group.commit_callback function="CommitSettings"/>
	</radio_group>
	<color_swatch bottom="44" left="16" can_apply_immediately="true" follows="left|bottom" height="52" label="Color"
	     name="val_color_swatch" visible="false" width="37">
		<color_swatch.commit_callback function="CommitSettings"/>
	</color_swatch>
	<spinner bottom="72" follows="left|bottom" height="24" label="x" label_width="74" left="16" max_val="10000000"
	     name="val_spinner_1" visible="false" width="160">
		<spinner.commit_callback function="CommitSettings"/>
	</spinner>
	<spinner bottom="72" follows="left|bottom" height="24" label="x" label_width="74" left="190"
	     max_val="10000000" name="val_spinner_2" visible="false" width="160">
		<spinner.commit_callback function="CommitSettings"/>
	</spinner>
	<spinner bottom="44" follows="left|bottom" height="24" label="x" label_width="74" left="16"
	     max_val="10000000" name="val_spinner_3" visible="false" width="160">
		<spinner.commit_callback function="CommitSettings"/>
	</spinner>
	<spinner bottom="44" follows="left|bottom" height="24" label="x" label_width="74" left="190"
	     max_val="10000000" name="val_spinner_4" visible="false" width="160">
		<spinner.commit_callback function="CommitSettings"/>
	</spinner>
    <text_editor follows="bottom|left|right" bottom="44" left="12" max_length="2147483647" right="-12" height="52" name="val_text" visible="false" hide_scrollbar="true" commit_on_focus_lost="true">
        <text_editor.commit_callback function="CommitSettings"/>
    </text_editor>
	<button bottom="12" follows="left|bottom" height="20" label="Copy Name" left="12" name="copy_btn" tool_tip="Copy the name of this setting."
	     width="130">
		<button.commit_callback function="ClickCopy"/>
	</button>
	<button follows="right|bottom" bottom="12" height="20" label="Reset to default" right="-12" name="default_btn"
	     width="130">
		<button.commit_callback function="ClickDefault"/>
	</button>
</floater>
