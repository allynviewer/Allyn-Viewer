<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel border="false" height="612" label="Input &amp; Camera" left="0" name="Input panel" width="648">
	<scroll_container bottom="-612" follows="all" height="612" left="0" name="input_scroll" opaque="false" width="648">
		<panel border="false" bottom="-920" follows="top|left" height="920" left="0" name="input_scroll_inner" width="628">
			<text bottom="-20" follows="top" font="SansSerifSmall" height="12" left="20" name=" Mouselook Options:" text_color="LabelSelectedColor">MOUSELOOK OPTIONS</text>
			<icon bottom="-26" follows="top" height="1" image_name="pref_section_rule.tga" left="20" name="mouselook_section_rule" width="588"/>
			<text bottom="-48" follows="top" height="12" left="20" name=" Mouse Sensitivity:">Mouse Sensitivity:</text>
			<slider_bar bottom="-72" follows="top" height="16" increment="0.25" initial_val="2" left="20" max_val="15" min_val="0" name="mouse_sensitivity" width="400"/>
			<check_box bottom="-100" follows="top" height="16" label="Invert Mouse" left="20" name="invert_mouse"/>
			<check_box bottom="-124" follows="top" height="16" control_name="LiruMouselookInstantZoom" label="Make rightclick zoom instantaneous, not smooth" left="20" name="instant_zoom"/>
			<check_box bottom="-148" follows="top" height="16" label="Display position and avatar health" left="20" name="AlchemyMouselookInstructions" control_name="AlchemyMouselookInstructions"/>
			<check_box bottom="-172" follows="top" height="16" label="Display targeted avatar's name under the crosshair" left="20" name="AlchemyMouselookIFF" control_name="AlchemyMouselookIFF"/>
			<check_box bottom="-196" follows="top" height="16" initial_value="false" label="Show Avatar in Mouselook" left="20" name="first_person_avatar_visible"/>
			<check_box bottom="-220" follows="top" height="16" control_name="UseRealisticMouselook" label="Use 'realistic' Camera behavior in Mouselook" left="20" name="UseRealisticMouselook"/>
			<text bottom="-248" follows="top" height="12" left="20" name="UI Hidden in mouselook:">UI Hidden in mouselook:</text>
			<check_box bottom="-272" follows="top" height="16" control_name="LiruMouselookHidesFloaters" name="mouselook_hides_floaters" label="Floaters" left="20"/>
			<check_box bottom="-272" follows="top" height="16" control_name="LiruMouselookHidesNotices" name="mouselook_hides_notices" label="Notices" left="320"/>
			<check_box bottom="-296" follows="top" height="16" control_name="LiruMouselookHidesMenubar" name="mouselook_hides_menubar" label="Menubar" left="20"/>
			<check_box bottom="-296" follows="top" height="16" control_name="LiruMouselookHidesToolbar" name="mouselook_hides_toolbar" label="Toolbar" left="320"/>
			<text bottom="-336" follows="top" font="SansSerifSmall" height="12" left="20" name=" Movement Options:" text_color="LabelSelectedColor">MOVEMENT OPTIONS</text>
			<icon bottom="-342" follows="top" height="1" image_name="pref_section_rule.tga" left="20" name="movement_section_rule" width="588"/>
			<check_box bottom="-368" follows="top" height="16" label="Fly/land on holding up/down" left="20" name="automatic_fly"/>
			<check_box bottom="-392" follows="top" height="16" label="Allow crouch toggle by holding shift" left="20" name="crouch_toggle" control_name="SGShiftCrouchToggle"/>
			<check_box bottom="-416" follows="top" height="16" label="Use azerty layout instead of qwerty layout" left="20" name="azerty_keys" control_name="LiruUseZQSDKeys"/>
			<text bottom="-456" follows="top" font="SansSerifSmall" height="12" left="20" name=" Camera Options:" text_color="LabelSelectedColor">CAMERA OPTIONS</text>
			<icon bottom="-462" follows="top" height="1" image_name="pref_section_rule.tga" left="20" name="camera_section_rule" width="588"/>
			<text bottom="-484" follows="top" height="12" left="20" name="camera_fov_label">Camera View Angle:</text>
			<slider bottom="-508" can_edit_text="true" decimal_digits="2" follows="top" width="400" height="16" increment=".025" initial_val="1.57" left="20" max_val="2.97" min_val=".17" name="camera_fov" value="60"/>
			<text bottom="-536" follows="top" height="12" left="20" name="Camera Follow Distance:">Camera Follow Distance:</text>
			<slider bottom="-560" can_edit_text="true" control_name="CameraOffsetScale" decimal_digits="2" follows="top" height="16" increment=".025" initial_val="1" left="20" min_val=".5" max_val="3" name="camera_offset_scale" value="1" width="400"/>
			<check_box bottom="-588" follows="top" left="20" height="16" control_name="SinguOffsetScrollKeys" label="Scrolling with control and/or shift held adjusts camera position" name="scroll_keys"/>
			<check_box bottom="-612" follows="top" left="20" height="16" label="Automatic Edit Camera Movement" name="edit_camera_movement" tool_tip="Use automatic camera positioning when entering and exiting edit mode"/>
			<check_box bottom="-636" follows="top" height="16" initial_value="false" label="Automatic Appearance Camera Movement" left="20" name="appearance_camera_movement" tool_tip="Use automatic camera positioning while in edit mode"/>
			<check_box bottom="-660" follows="top" height="16" initial_value="false" label="Unsit Avatar on Camera Reset" left="20" name="unsit_on_camera_reset" tool_tip="Stand up automatically when you press Esc and the camera switches to third person mode"/>
			<check_box bottom="-684" follows="top" height="16" label="Disable Camera Constraints" left="20" control_name="DisableCameraConstraints" name="DisableCameraConstraints" tool_tip="Prevent the camera from automatically zooming when you approach walls, objects, etc., too closely."/>
			<check_box bottom="-708" follows="top" height="16" label="Limit Select Distance" left="20" control_name="LimitSelectDistance" name="Limit Select Distance" tool_tip="Limit the distance at which an object can be selected."/>
			<button bottom="-756" follows="top" font="SansSerif" height="28" image_overlay="pref_nav_input.tga" image_overlay_alignment="left" label="Joystick Setup" left="174" name="joystick_setup_button" pad_left="10" scale_image="true" width="280"/>
		</panel>
	</scroll_container>
</panel>
