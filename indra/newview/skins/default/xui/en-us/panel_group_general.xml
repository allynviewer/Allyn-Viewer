<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel border="true" bottom="0" follows="all" height="476" label="General" left="1"
     mouse_opaque="true" name="general_tab" select="true" width="480">
	<string name="help_text">
		The General tab contains general information about
this group, a list of Owners and visible Members, 
general Group Preferences and member options.

Hover your mouse over the options for more help.
	</string>
	<string name="group_info_unchanged">
		General group information has changed.
	</string>
	<button bottom="-22" follows="right|top" font="SansSerif" halign="center" height="16"
	     label="?" label_selected="?" left="454" mouse_opaque="true"
	     name="help_button" width="20" />
	<line_editor bg_visible="false" border_drop_shadow_visible="false" border_visible="false"
	     bottom="-22" drop_shadow_visible="true" follows="left|top|right" font="SansSerif"
	     h_pad="0" halign="left" height="16" label="Type your new group name here"
	     left="7" max_length="35" mouse_opaque="true" name="group_name_editor"
	     prevalidate="ascii" v_pad="0" width="440" spell_check="true" />
	<name_box bg_visible="false" border_drop_shadow_visible="false" border_visible="false"
	     bottom="-22" drop_shadow_visible="true" follows="left|top|right"
	     font="SansSerifBig" h_pad="0" halign="left" height="16" left="7"
	     mouse_opaque="true" name="group_name" v_pad="0" id_type="1" width="440">
		Type your new group name here
	</name_box>
	<text bottom="-40" follows="left|top" font="SansSerifSmall" height="16" left="7"
	     name="prepend_founded_by" width="128">
		Founded by
	</text>
	<name_box bg_visible="false" border_drop_shadow_visible="false" border_visible="false"
	     bottom="-40" drop_shadow_visible="true" follows="left|top|right"
	     font="SansSerifSmall" h_pad="0" halign="left" height="16" left="138"
	     mouse_opaque="true" name="founder_name" v_pad="0" initial_value="Loading..."
	     width="220" />
	<text bottom="-58" follows="left|top" font="SansSerifSmall" height="16" left="7"
	     name="group_key_text" width="128">
		Group Key:
	</text>
	<line_editor bevel_style="in" border_style="line" border_thickness="1" bottom="-58"
	     enabled="false" follows="left|top|right" font="SansSerifSmall" height="16"
	     is_unicode="false" left="138" max_length="254" mouse_opaque="false"
	     name="group_key" width="220" />
	<button bottom="-58" follows="right|top" height="16" width="100" left="366"
	     name="copy_uri" label="Copy URI">
		<button.commit_callback function="Group.CopyURI"/>
	</button>
	<text bottom="-78" follows="left|top|right" font="SansSerifSmall" halign="left"
	     height="16" left="143" name="group_charter_label" right="-7" width="330">
		Group Charter
	</text>
	<string name="join_btn_label">
		Join ([FEE])
	</string>
	<texture_picker bottom="-200" follows="left|top" height="128" label=""
	     left="7" mouse_opaque="true" name="insignia" tool_tip="Click to choose a picture"
	     width="128" />
	<text_editor bg_visible="true" border_drop_shadow_visible="false" border_visible="true"
	     bottom="-200" drop_shadow_visible="false" follows="left|top|right"
	     font="SansSerifSmall" h_pad="4" halign="left" height="128"
	     hide_scrollbar="false" max_length="511" mouse_opaque="true" name="charter"
	     left="143" right="-7" v_pad="2" width="330" word_wrap="true" spell_check="true">
		Group Charter
	</text_editor>
	<button bottom="-226" follows="left|top" font="SansSerif" halign="center"
	     height="22" label="Join ([CURRENCY]0)" label_selected="Join ([CURRENCY]0)" left="7"
	     mouse_opaque="true" name="join_button" width="128" />
	<button bottom="-226" follows="left|top" font="SansSerif" halign="center"
	     height="22" label="Detailed View" label_selected="Detailed View"
	     left="7" mouse_opaque="true" name="info_button" width="128" />
	<name_list allow_calling_card_drop="false" background_visible="true" bottom="-338"
	     column_padding="0" draw_border="true" draw_heading="true" multi_select="true"
	     follows="left|top|right" heading_font="SansSerifSmall" heading_height="14"
	     height="106" left="7" mouse_opaque="true" menu_num="0" name_system="GroupMembersNameSystem"
	     name="visible_members" width="466">
		<column label="Member Name" name="name" relwidth="0.45" />
		<column label="Title" name="title" relwidth="0.30" />
		<column label="Last Login" name="online" relwidth="0.25" />
	</name_list>
	<text bottom="-354" follows="left|top" font="SansSerif" height="16" left="7"
	     name="text_group_preferences">
		Group Preferences
	</text>
	<panel background_opaque="true" background_visible="false" bevel_style="in"
	     border="true" bottom="-470" follows="left|top|right" height="112" left="7"
	     mouse_opaque="true" name="preferences_container" width="466">
		<check_box bottom="-18" follows="left|top" font="SansSerifSmall" height="16"
		     initial_value="true" label="Show in search" left="6" mouse_opaque="true"
		     name="show_in_group_list" radio_style="false"
		     tool_tip="Let people see this group in search results." width="220" />
		<check_box bottom="-36" follows="left|top" font="SansSerifSmall" height="16"
		     initial_value="false" label="Open enrollment" left="6" mouse_opaque="true"
		     name="open_enrollement" radio_style="false"
		     tool_tip="Sets whether this group allows new members to join   without being invited."
		     width="220" />
		<check_box bottom="-54" follows="left|top" font="SansSerifSmall" height="16"
		     initial_value="false" label="Enrollment fee: [CURRENCY]" left="6"
		     max_length="5" mouse_opaque="true" name="check_enrollment_fee"
		     radio_style="false"
		     tool_tip="Sets whether to require an enrollment fee to join the group."
		     width="160" />
		<spinner bg_visible="false" border_drop_shadow_visible="false" border_visible="false"
		     bottom="-54" decimal_digits="0" drop_shadow_visible="true"
		     follows="left|top" font="SansSerif" h_pad="0" halign="left" height="16"
		     increment="1" label_width="10" left="170" max_val="99999" min_val="0"
		     mouse_opaque="true" name="spin_enrollment_fee"
		     tool_tip="New members must pay this fee to join the group when   Enrollment Fee is checked."
		     v_pad="0" width="65" />
		<text bottom="-74" left="6" font="SansSerifSmall" height="16" name="content_rating">
				Content Rating
		</text>
		<combo_box allow_text_entry="false" bottom="-98" follows="left|top" height="20" left="6"
			max_chars="20" mouse_opaque="true" name="group_mature_check"
			tool_tip="Sets whether your group information is considered mature."
			width="160">
			<combo_item name="select_mature" value="Select">
			- Select Mature -
			</combo_item>
			<combo_item name="mature" value="Mature">
			Mature Content
			</combo_item>
			<combo_item name="pg" value="PG">
			PG Content
			</combo_item>
		</combo_box>

		<check_box bottom="-18" left="248" follows="left|top" font="SansSerifSmall" height="16"
		     initial_value="false" label="Receive group notices"
		     mouse_opaque="true" name="receive_notices" radio_style="false"
		     tool_tip="Sets whether you want to receive Notices from this group.   Uncheck this box if this group is spamming you."
		     width="210" />
		<check_box bottom="-36" left="248" follows="left|top" font="SansSerifSmall" height="16"
			initial_value="false" label="Join group chat"
			mouse_opaque="true" name="receive_chat" radio_style="false"
			tool_tip="Sets whether you want to participate in group chat.   Uncheck this box if this group is spamming you."
			width="210" />
		<check_box bottom="-54" left="248" follows="left|top" font="SansSerifSmall" height="16"
		     initial_value="false" label="List group in my profile"
		     mouse_opaque="true" name="list_groups_in_profile" radio_style="false"
		     tool_tip="Sets whether you want to list this group in your Profile"
		     width="210" />
		<text bottom="-74" font="SansSerifSmall" height="16" left="248" name="active_title_label">
			My Active Title
		</text>
		<combo_box length="120" width="210" bottom="-98" follows="left|top" height="20"
		     left="248" name="active_title"
		     tool_tip="Sets the title that appears in your avatar&apos;s name tag   when this group is active." />
	</panel>
	<string name="incomplete_member_data_str">
		Retrieving member data
	</string>
	<string name="confirm_group_create_str">
		Creating this group will cost [GROUPCREATEFEE]. 
Are you really, really, REALLY sure you want to spend [GROUPCREATEFEE] to create this group?
Be aware that if nobody else joins this group within 48 hours, it will be disbanded and the group&apos;s name will be unavailable for future use.
	</string>
</panel>
