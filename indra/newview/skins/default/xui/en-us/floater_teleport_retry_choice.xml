<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="teleport_retry_choice"
 title="Region is full"
 rect_control="ALLTeleportRetryChoiceRect"
 can_close="true"
 can_minimize="false"
 can_resize="false"
 width="420"
 height="210"
 layout="topleft">
 <text name="prompt"
   left="20"
   bottom="-30"
   width="380"
   height="32"
   follows="top|left"
   word_wrap="true">The destination region is full. Choose how to proceed:</text>
 <text name="dest_region_label"
   left="20"
   bottom="-60"
   width="80"
   height="16"
   follows="top|left">Region:</text>
 <text name="dest_region"
   left="100"
   bottom="-60"
   width="300"
   height="16"
   follows="top|left"
   font="SansSerifBold">-</text>
 <text name="mode_label"
   left="20"
   bottom="-92"
   width="140"
   height="16"
   follows="top|left">Teleport mode:</text>
 <combo_box name="mode_combo"
   left="160"
   bottom="-94"
   width="240"
   height="22"
   follows="top|left">
  <combo_item name="single" value="0">Single teleport</combo_item>
  <combo_item name="multiple" value="1">Multiple teleport</combo_item>
 </combo_box>
 <check_box name="ask_again"
   left="20"
   bottom="-128"
   width="380"
   height="16"
   follows="top|left"
   label="Don't ask again"/>
 <button name="ok_button"
   left="196"
   bottom="-170"
   width="100"
   height="26"
   follows="top|left"
   label="Confirm"/>
 <button name="cancel_button"
   left="304"
   bottom="-170"
   width="100"
   height="26"
   follows="top|left"
   label="Cancel"/>
</floater>
