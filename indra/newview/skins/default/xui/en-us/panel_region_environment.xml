<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
 border="true"
 follows="left|right|top|bottom"
 height="548"
 label="Environment"
 layout="topleft"
 help_topic="panel_region_environment_tab"
 name="panel_env_info"
 width="690">
 <text
  name="water_settings_title"
  follows="top|left|right"
  height="40"
  layout="topleft"
  left="16"
  bottom="-48"
  width="658"
  word_wrap="true">
  Select the Water and Sky/Day Cycle Settings you would like all visitors to your region to see.
 </text>
 <view_border
  bevel_style="none"
  follows="top|left|right|bottom"
  height="400"
  layout="topleft"
  left="16"
  name="border"
  bottom="72"
  width="658"/>
 <radio_group
  follows="top|left"
  height="56"
  layout="topleft"
  draw_border="false"
  left="32"
  name="region_settings_radio_group"
  bottom="-120"
  width="400">
  <radio_item
   layout="topleft"
   bottom="36"
   name="use_sl_default_settings">
   Use Second Life default
  </radio_item>
  <radio_item
   layout="topleft"
   name="use_my_settings"
   bottom_delta="-24">
   Use the following settings
  </radio_item>
 </radio_group>
 <panel
  follows="top|left|right|bottom"
  height="280"
  layout="topleft"
  left="32"
  name="user_environment_settings"
  bottom="88"
  width="626">
   <text
    name="water_settings_title"
    follows="top|left"
    height="20"
    layout="topleft"
    left="0"
    bottom="-28"
    width="180">
    Water Setting
   </text>
   <combo_box
    follows="top|left|right"
    height="24"
    left="200"
    name="water_settings_preset_combo"
    bottom="-32"
    width="400">
    <combo_item
     name="item0">
     -Select a preset-
    </combo_item>
   </combo_box>
   <text
    name="sky_dayc_settings_title"
    follows="top|left"
    height="20"
    layout="topleft"
    left="0"
    bottom="-72"
    width="180">
    Sky / Day Cycle
   </text>
   <radio_group
    layout="topleft"
    draw_border="false"
    left="0"
    name="sky_dayc_settings_radio_group"
    bottom="-140"
    height="56"
    width="180">
    <radio_item
     layout="topleft"
     bottom="36"
     name="my_sky_settings">
     Fixed sky
    </radio_item>
    <radio_item
     layout="topleft"
     name="my_dayc_settings"
     bottom_delta="-24">
     Day cycle
    </radio_item>
   </radio_group>
   <combo_box
    follows="top|left|right"
    height="24"
    left="200"
    name="sky_settings_preset_combo"
    bottom="-96"
    width="400">
    <combo_item
     name="item0">
     -Select a preset-
    </combo_item>
   </combo_box>
   <combo_box
    follows="top|left|right"
    height="24"
    left="200"
    name="dayc_settings_preset_combo"
    bottom="-136"
    width="400">
    <combo_item
     name="item0">
     -Select a preset-
    </combo_item>
   </combo_box>
 </panel>
 <button
  follows="left|bottom"
  height="28"
  label="Apply"
  layout="topleft"
  left="430"
  name="apply_btn"
  image_overlay="icn_region_apply.png"
  image_overlay_alignment="left"
  pad_left="6"
  font="SansSerifSmall"
  bottom="20"
  width="120" />
 <button
  follows="left|bottom"
  height="28"
  label="Cancel"
  layout="topleft"
  left="558"
  name="cancel_btn"
  image_overlay="icn_region_cancel.png"
  image_overlay_alignment="left"
  pad_left="6"
  font="SansSerifSmall"
  bottom="20"
  width="120" />
 <loading_indicator
  width="23" />
 <text
  follows="left|bottom"
  font="SansSerifHuge"
  height="28"
  left="16"
  name="progress_indicator"
  bottom="20"
  visible="false">
  Applying
 </text>
</panel>
