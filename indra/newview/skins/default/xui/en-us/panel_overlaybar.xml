<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel follows="left|right|bottom|top" height="300" left="-1" mouse_opaque="false"
     user_resize="false" name="overlay" use_bounding_rect="true" width="728">
	<layout_stack align_overflow_end="true" bottom="0" follows="left|right|bottom" height="300" left="0"
	     mouse_opaque="false" name="overlay_layout_panel" orientation="horizontal"
	     right="-1" use_bounding_rect="true">
		<layout_panel auto_resize="true" bottom="0" left="0" min_width="0" mouse_opaque="false"
		     use_bounding_rect="true" user_resize="false" width="420" name="main_panel">
			<layout_stack bottom="0" follows="left|right|bottom|top" height="50" left="0"
			     mouse_opaque="false" name="chatbar_and_buttons" orientation="vertical"
			     right="420" use_bounding_rect="true">
				<layout_panel auto_resize="true" bottom="0" follows="left|bottom|right|top" height="0"
				     left="0" min_height="20" min_width="100" mouse_opaque="false"
				     name="padding" use_bounding_rect="true" user_resize="false" width="420" />
				<layout_panel auto_resize="false" bottom="0" follows="left|bottom|right|top" height="20"
				     left="0" min_height="20" min_width="100" mouse_opaque="false"
				     name="state_management_buttons_container" use_bounding_rect="true" user_resize="false"
				     width="799">
					<button bottom="1" follows="left|bottom" font="SansSerif" halign="center" height="20"
					     label="New IM" label_selected="New IM" left="0"
					     name="New IM" scale_image="true"
					     tool_tip="You have an instant message pending. Click to show IMs."
					     width="102" />
					<button bottom="1" follows="left|bottom" font="SansSerif" halign="center" height="20"
					     label="Set Not Busy" label_selected="Set Not Busy" left="114"
					     name="Set Not Busy" scale_image="true"
					     tool_tip="Chat and IM is hidden for you. Click here to set yourself not busy."
					     width="112" />
					<button bottom="1" follows="left|bottom" font="SansSerif" halign="center" height="20"
					     label="Flycam" label_selected="Flycam" left="229" name="Flycam" scale_image="true"
					     tool_tip="Your camera is under joystick control, click here to release it."
					     width="102" />
					<button bottom="1" follows="left|bottom" font="SansSerif" halign="center" height="20"
					     label="Stand Up" label_selected="Stand Up" left="457" name="Stand Up"
					     scale_image="true" tool_tip="Click here to stand up." width="102" />
          <button bottom="1" follows="left|bottom" font="SansSerif" halign="center" height="20"
					     label="Cancel TP" label_selected="Cancel TP" left="571" name="Cancel TP"
					     scale_image="true" tool_tip="Click here to cancel the current teleport process." width="102" />
        </layout_panel>
        <layout_panel auto_resize="false" background_visible="false" border="false" bottom="0"
            follows="left|right|bottom" left="0" min_height="24" mouse_opaque="false" name="chat_bar_layout_panel" user_resize="false"
            use_bounding_rect="true" width="395" >
                <panel name="chat_bar" filename="panel_chat_bar.xml" width="395" mouse_opaque="false"
                    bottom="0" default_tab_group="1" follows="left|bottom|right" height="25"
                    left="0"/>
        </layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel auto_resize="false" bottom="0" left="0" min_width="31" mouse_opaque="false"
			name="ao_light_container" use_bounding_rect="true" user_resize="false"
			width="31">
			<button bottom="0" follows="left|bottom" font="SansSerif" font-style="BOLD" sound_flags="0"
				height="29" width="29" left="0" label="" name="overlay_ao_check"
				control_name="AOEnabled" toggle="true" scale_image="true"
				image_selected="ao_status_on.png"
				image_unselected="ao_status_off.png"
				image_disabled="ao_status_off.png"
				tool_tip="Red is AO off. Green is AO on. Click to switch." />
		</layout_panel>
		<layout_panel auto_resize="false" bottom="0" left="0" min_width="94" mouse_opaque="false"
			name="ao_remote_container" use_bounding_rect="true" user_resize="false"
			width="94">
			<button bottom="0" follows="left|bottom" font="SansSerif" font-style="BOLD" halign="left" sound_flags="0"
				height="29" width="92" left="0" label="AO OFF" label_selected="AO ON" name="overlay_ao_btn"
				control_name="AOEnabled" scale_image="true"
				image_selected="toolbar_btn_selected.tga"
				image_unselected="toolbar_btn_enabled.tga"
				image_disabled="toolbar_btn_disabled.tga"
				image_overlay="inv_item_animation.tga"
				image_overlay_alignment="left"
				tool_tip="Shows AO ON or AO OFF. Click to open AO settings." />
		</layout_panel>
		<layout_panel auto_resize="false" bottom="0" left="0" min_width="220" mouse_opaque="false"
		     name="voice_remote_container" use_bounding_rect="true" user_resize="false"
		     width="220">
			<panel background_visible="false" border="false" bottom="0" name="voice_remote" />
		</layout_panel>
		<layout_panel auto_resize="false" bottom="0" left="0" min_width="114" mouse_opaque="false"
			name="media_remote_container" use_bounding_rect="true" user_resize="false"
			width="114">
			<button bottom="0" follows="left|bottom" font="SansSerif" font-style="BOLD" halign="left" sound_flags="0"
				height="29" width="112" left="0" label="Volume" label_selected="Volume" name="overlay_volume_btn"
				control_name="ShowVolumeSettingsPopup" toggle="true" scale_image="true"
				image_selected="toolbar_btn_selected.tga"
				image_unselected="toolbar_btn_enabled.tga"
				image_disabled="toolbar_btn_disabled.tga"
				image_overlay="icn_speaker_dark.tga"
				image_overlay_alignment="left"
				tool_tip="Volume, music and media. Click to open controls." />
		</layout_panel>
		<layout_panel auto_resize="false" bottom="0" left="0" min_width="114" mouse_opaque="false"
			name="AdvSettings_container" use_bounding_rect="true" user_resize="false"
			width="114">
			<button bottom="0" follows="left|bottom" font="SansSerif" font-style="BOLD" halign="left" sound_flags="0"
				height="29" width="112" left="0" label="Environment" label_selected="Environment" name="overlay_env_btn"
				control_name="wlfAdvSettingsPopup" toggle="true" scale_image="true"
				image_selected="toolbar_btn_selected.tga"
				image_unselected="toolbar_btn_enabled.tga"
				image_disabled="toolbar_btn_disabled.tga"
				image_overlay="Inv_WindLight.png"
				image_overlay_alignment="left"
				tool_tip="Environment: sky, water, time and presets. Click to open controls." />
		</layout_panel>
	</layout_stack>
	<button bottom="31" follows="left|bottom" font="SansSerif" font-style="BOLD" halign="left" sound_flags="0"
		height="29" width="112" left="0" label="mouselock" label_selected="mouselock" name="Mouselook"
		scale_image="true"
		image_selected="toolbar_btn_selected.tga"
		image_unselected="toolbar_btn_enabled.tga"
		image_disabled="toolbar_btn_disabled.tga"
		image_overlay="inv_item_eyes.tga"
		image_overlay_alignment="left"
		tool_tip="Use mouse to steer your view. If you have a gun, clicking will shoot. Click again to leave mouselook." />
  <string name="unread_count_string_plural">
    New IMs
  </string>
</panel>
