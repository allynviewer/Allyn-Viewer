	<button bottom="128" follows="left|bottom" height="22" label="" left="332" image_overlay="arrow_left.tga" name="PPprev" scale_image="true" width="22"/>
	<button bottom="128" follows="left|bottom" height="22" label="" left="358" image_overlay="arrow_right.tga" name="PPnext" scale_image="true" width="22"/>
	<button bottom="100" left="10" follows="left|bottom" height="22" name="EnvAdvancedSkyButton" width="22" image_overlay="Inv_WindLight.png" label="" tool_tip="Advanced Sky"/>
	<combo_box name="WLSkyPresetsCombo" bottom="101" left="38" follows="left|bottom" height="20" width="286" tool_tip="WindLight Presets for your Sky."/>
	<button bottom="100" follows="left|bottom" height="22" label="" left="332" image_overlay="arrow_left.tga" name="WLprev" scale_image="true" width="22"/>
	<button bottom="100" follows="left|bottom" height="22" label="" left="358" image_overlay="arrow_right.tga" name="WLnext" scale_image="true" width="22"/>
	<button bottom="72" left="10" follows="left|bottom" height="22" name="EnvAdvancedWaterButton" width="22" image_overlay="Inv_WaterLight.png" label="" tool_tip="Advanced Water"/>
	<combo_box name="WLWaterPresetsCombo" bottom="73" left="38" follows="left|bottom" height="20" width="286" tool_tip="WindLight Presets for your Water."/>
	<button bottom="72" follows="left|bottom" height="22" label="" left="332" image_overlay="arrow_left.tga" name="WWprev" scale_image="true" width="22"/>
	<button bottom="72" follows="left|bottom" height="22" label="" left="358" image_overlay="arrow_right.tga" name="WWnext" scale_image="true" width="22"/>
