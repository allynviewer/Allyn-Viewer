<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel bg_visible="false" border="false" border_visible="false" height="312" name="Adv_Settings" use_bounding_rect="false" width="400">
	<text bottom="286" left="10" height="18" width="220" follows="left|bottom" name="Camera Preset:">Camera</text>
	<button bottom="282" left="300" width="22" height="22" label="" toggle="true" follows="left|bottom" scale_image="true" image_selected="Cam_Preset_Back_On.png" image_unselected="Cam_Preset_Back_Off.png" name="Rear" tool_tip="Rear View">
		<button.commit_callback function="Wlf.ChangeCameraPreset" parameter="0"/>
	</button>
	<button bottom="282" left="326" width="22" height="22" label="" toggle="true" follows="left|bottom" scale_image="true" image_selected="Cam_Preset_Front_On.png" image_unselected="Cam_Preset_Front_Off.png" name="Front" tool_tip="Front View">
		<button.commit_callback function="Wlf.ChangeCameraPreset" parameter="1"/>
	</button>
	<button bottom="282" left="352" width="22" height="22" label="" toggle="true" follows="left|bottom" scale_image="true" image_selected="Cam_Preset_Side_On.png" image_unselected="Cam_Preset_Side_Off.png" name="Group" tool_tip="Side View">
		<button.commit_callback function="Wlf.ChangeCameraPreset" parameter="2"/>
	</button>
	<slider bottom="254" left="10" follows="left|bottom" control_name="RenderFarClip" decimal_digits="0" height="20" increment="8" label="Draw distance" can_edit_text="true" label_width="155" max_val="1024" min_val="24" val_width="48" name="DrawDistance" width="380" tool_tip="Change your Draw Distance"/>
	<slider bottom="230" left="10" follows="left|bottom" height="20" increment=".001" label="Hover height" can_edit_text="true" label_width="155" max_val="5" min_val="-5" val_width="48" name="HoverHeightSlider" width="380"/>
