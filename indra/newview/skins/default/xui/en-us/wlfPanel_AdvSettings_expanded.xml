	<slider bottom="12" follows="left|bottom" control_name="EnvTimeSlider" left="10" height="12" increment="0.00000001" label="" max_val="1" min_val="0" name="EnvTimeSlider" show_text="false" width="380"/>
	<button bottom="0" height="1" label="" left="0" name="expand" visible="false" width="1"/>
</panel>
