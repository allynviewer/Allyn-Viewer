	<slider bottom="158" left="10" follows="left|bottom" control_name="RenderVolumeLODFactor" height="20" increment="0.125" label="Object detail" can_edit_text="true" label_width="155" max_val="4" min_val="0.5" name="Object Detail" val_width="48" width="380" tool_tip="Controls level of detail of primitives (multiplier for current screen area when calculated level of detail[0.5 to 2.0 is stable])"/>
