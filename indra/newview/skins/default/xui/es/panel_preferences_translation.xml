 <combo_item name="both" value="both">Original y traducción</combo_item>
 </combo_box>
 <text bottom_delta="-28" follows="top" height="14" left="10" name="in_color_label" width="120">Color de entrada:</text>
 <color_swatch bottom_delta="-20" can_apply_immediately="false" control_name="AITranslateIncomingColor" follows="top" height="34" left="130" name="incoming_color" width="30"/>
 <text bottom_delta="20" follows="top" height="14" left="200" name="out_color_label" width="120">Color de salida:</text>
 <color_swatch bottom_delta="-20" can_apply_immediately="false" control_name="AITranslateOutgoingColor" follows="top" height="34" left="320" name="outgoing_color" width="30"/>
 <text bottom_delta="-40" follows="top" font="SansSerifSmall" height="80" left="10" name="privacy_tip" width="470" word_wrap="true">Yo hablo / Otros hablan = cualquier idioma (código ISO: ja, ru, zh...).&#10;Saliente: tú→otros. Entrante: otros→tú.&#10;[IA] solo en entrante. Sin línea duplicada si el texto ya está en el idioma de destino.</text>
 </panel>
 <panel border="true" bottom="-190" height="180" label="Grupos" left="1" name="Groups" width="500">
 <check_box bottom="-20" control_name="AITranslateGroupsEnabled" follows="top" height="16" label="Traducir chats de grupo" left="10" name="groups_enable"/>
 <text bottom_delta="-18" follows="top" height="14" left="10" name="group_mode_label" width="80">Grupos:</text>
 <combo_box bottom_delta="-2" control_name="AITranslateGroupMode" follows="top" height="18" left="90" name="group_mode" width="280">
 <combo_item name="all" value="all">Todos mis grupos</combo_item>
 <combo_item name="selected" value="selected">Solo seleccionados</combo_item>
 </combo_box>
 <scroll_list column_padding="4" draw_heading="true" follows="top" height="100" left="10" multi_select="true" name="group_list" tool_tip="Ctrl+clic para seleccionar varios grupos (modo Seleccionados)" width="470">
 <column dynamicwidth="true" label="Grupo" name="name" width="450"/>
 </scroll_list>
 <button follows="top" height="20" label="Actualizar grupos" left="10" name="group_refresh_btn" width="160"/>
 </panel>
 <panel border="true" bottom="-370" height="360" label="Proveedor" left="1" name="Provider" width="500">
 <text bottom_delta="-22" follows="top" height="14" left="10" name="provider_label" width="80">Proveedor:</text>
 <combo_box bottom_delta="-2" control_name="AITranslateProvider" follows="top" height="18" left="100" name="provider_combo" width="280">
 <combo_item name="openai" value="openai">OpenAI (ChatGPT)</combo_item>
 <combo_item name="anthropic" value="anthropic">Anthropic (Claude)</combo_item>
 <combo_item name="opencode_zen" value="opencode_zen">OpenCode Zen</combo_item>
 <combo_item name="openrouter" value="openrouter">OpenRouter</combo_item>
 <combo_item name="custom" value="custom">Personalizado (compatible con OpenAI)</combo_item>
 </combo_box>
 <text bottom_delta="-24" follows="top" height="14" left="10" name="key_label" width="80">Clave API:</text>
 <line_editor bottom_delta="-2" control_name="AITranslateApiKey" follows="top" height="18" left="100" max_length_chars="256" name="api_key" width="360"/>
 <text bottom_delta="-24" follows="top" height="14" left="10" name="url_label" width="80">URL base:</text>
 <line_editor bottom_delta="-2" control_name="AITranslateBaseUrl" follows="top" height="18" left="100" max_length_chars="512" name="base_url" width="360"/>
 <text bottom_delta="-24" follows="top" height="14" left="10" name="model_label" width="80">Modelo:</text>
 <line_editor bottom_delta="-2" control_name="AITranslateModel" follows="top" height="18" left="100" max_length_chars="128" name="model" width="360"/>
 <button bottom_delta="-30" follows="top" height="22" label="Probar conexión" left="100" name="test_btn" width="140"/>
 <text bottom_delta="-110" follows="top" font="SansSerifSmall" height="88" left="10" name="status_text" width="470" word_wrap="true">No probado</text>
 <text bottom_delta="-100" follows="top" font="SansSerifSmall" height="64" left="10" name="provider_tip" width="470" word_wrap="true">La clave API se guarda en la configuración local (solo en este PC).&#10;OpenCode Zen: chat/completions (p. ej. mimo-v2.5-free).&#10;OpenRouter: https://openrouter.ai/api/v1 (p. ej. minimax/minimax-m3:free).</text>
 </panel>
 </tab_container>
</panel>
