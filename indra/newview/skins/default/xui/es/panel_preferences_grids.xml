<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel label="Cuadrículas" name="Grids panel">
	<text name="grid_selector_label" >
		Elegir un grid:
	</text>
	<combo_box name="grid_selector" width="180" />
	<button label="Predeterminado" name="btn_default" width="92" left_delta="190"/>
	<text name="default_grid" left_delta="100">
		([PREDETERMINADO])
	</text>
	<button label="Borrar" label_selected="Borrar" name="btn_delete" tool_tip="Borrar de la lista el Grid seleccionado"/>
	<button label="Crear" label_selected="Añadir" name="btn_add" tool_tip="Agregar un nuevo Grid a la lista"/>
	<button label="Copiar" label_selected="Copiar" name="btn_copy" tool_tip="Crear una nueva entrada usando la seleccionada como plantilla"/>
	<button label="Avanzado" label_selected="Avanzado" name="btn_advanced"/>
	<text name="loginuri_label">
		URL de Inicio:
	</text>
	<line_editor max_length="254" enabled="true" name="loginuri" handle_edit_keys_directly="true" height="18" left="120" right="-12" bottom_delta="-4" halign="right" font="SansSerifSmall" follows="left|top|right" border_visible="false" mouse_opaque="false" drop_shadow_visible="true" border_drop_shadow_visible="false"/>
	<button label="Actualizar Información del Grid" name="btn_gridinfo" width="174" left="120" tool_tip="Recuperar toda la información del grid desde la URI de inicio de sesión indicada (sobreescribiendo las URLs actuales, ver Avanzado)"/>
	<text name="platform_label">
		Plataforma:
	</text>
	<combo_box max_chars="20" allow_text_entry="false" name="platform" height="18" width="200" left="120" bottom_delta="-4" follows="left|top" mouse_opaque="true"/>
	<text name="gridname_label">
		Nombre del Grid:
	</text>
	<line_editor max_length="254" enabled="true" name="gridname" handle_edit_keys_directly="true" height="18" left="120" right="-12" bottom_delta="-4" halign="right" font="SansSerifSmall" follows="left|top|right" border_visible="false" mouse_opaque="false" drop_shadow_visible="true" border_drop_shadow_visible="false"/>
	<text name="gridmessage_label">
		Info del Grid:
	</text>
	<text_editor type="string" length="1" bottom="-185" embedded_items="false" enabled="true" follows="left|top|right" handle_edit_keys_directly="true" font="SansSerifSmall" height="50" left="120" right="-12" bottom_delta="-4" max_length="512" mouse_opaque="true" name="gridmessage" word_wrap="true" spell_check="true"/>
	<text name="loginpage_label">
		Pág. de Bienvenida:
	</text>
	<line_editor max_length="254" enabled="true" name="loginpage" handle_edit_keys_directly="true" visible="false" height="18" left="120" right="-12" bottom_delta="-4" halign="right" font="SansSerifSmall" follows="left|top|right" border_visible="false" mouse_opaque="false" drop_shadow_visible="true" border_drop_shadow_visible="false"/>
	<text name="helperuri_label">
		URI de Ayuda:
	</text>
	<line_editor max_length="254" enabled="true" name="helperuri" handle_edit_keys_directly="true" visible="false" height="18" left="120" right="-12" bottom_delta="-4" halign="right" font="SansSerifSmall" follows="left|top|right" border_visible="false" mouse_opaque="false" drop_shadow_visible="true" border_drop_shadow_visible="false"/>
	<text name="website_label">
		Sitio Web:
	</text>
	<line_editor max_length="254" enabled="true" name="website" handle_edit_keys_directly="true" visible="false" height="18" left="120" right="-12" bottom_delta="-4" halign="right" font="SansSerifSmall" follows="left|top|right" border_visible="false" mouse_opaque="false" drop_shadow_visible="true" border_drop_shadow_visible="false"/>
	<text name="support_label">
		URL de Soporte:
	</text>
	<line_editor max_length="254" enabled="true" name="support" handle_edit_keys_directly="true" visible="false" height="18" left="120" right="-12" bottom_delta="-4" halign="right" font="SansSerifSmall" follows="left|top|right" border_visible="false" mouse_opaque="false" drop_shadow_visible="true" border_drop_shadow_visible="false"/>
	<text name="register_label">
		URL de Usuario:
	</text>
	<line_editor max_length="254" enabled="true" name="register" handle_edit_keys_directly="true" visible="false" height="18" left="120" right="-12" bottom_delta="-4" halign="right" font="SansSerifSmall" follows="left|top|right" border_visible="false" mouse_opaque="false" drop_shadow_visible="true" border_drop_shadow_visible="false"/>
	<text name="password_label">
		URL Contraseña:
	</text>
	<line_editor max_length="254" enabled="true" name="password" handle_edit_keys_directly="true" visible="false" height="18" left="120" right="-12" bottom_delta="-4" halign="right" font="SansSerifSmall" follows="left|top|right" border_visible="false" mouse_opaque="false" drop_shadow_visible="true" border_drop_shadow_visible="false"/>
	<text name="partner_label" >
		URL de Pareja:
	</text>
	<line_editor max_length="254" name="partner" handle_edit_keys_directly="true" height="18" left="120" right="-12" bottom_delta="-4" font="SansSerifSmall" follows="left|top|right" visible="false"/>
	<text name="search_label">
		URL de Búsqueda:
	</text>
	<line_editor max_length="254" enabled="true" name="search" handle_edit_keys_directly="true" visible="false" height="18" left="120" right="-12" bottom_delta="-4" halign="right" font="SansSerifSmall" follows="left|top|right" border_visible="false" mouse_opaque="false" drop_shadow_visible="true" border_drop_shadow_visible="false"/>
	<check_box label="Compatibilidad de Renderizado" name="render_compat"/>
	<button label="?" name="btn_help_render_compat" left_delta="200" />
</panel>
