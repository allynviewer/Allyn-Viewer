<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<string name="online_users_title">USUÁRIOS ONLINE</string>
	<string name="online_allyn_label">ALLYN VIEWER</string>
	<string name="online_sl_label">SECOND LIFE</string>
	<panel name="login_form_bg">
		<scroll_container name="login_form_scroll">
			<panel name="login_form_inner">
				<panel name="online_users_panel">
					<text name="online_users_title">USUÁRIOS ONLINE</text>
				</panel>
				<text name="login_title">ALLYN VIEWER</text>
				<text name="login_subtitle">Entre para continuar</text>
				<text name="name_label">Usuário</text>
				<text name="password_text">Senha</text>
				<panel name="location_panel">
					<text name="start_location_text">Posição inicial</text>
					<combo_box name="start_location_combo">
						<combo_item name="MyHome">Minha casa</combo_item>
						<combo_item name="MyLastLocation">Última posição</combo_item>
						<combo_item name="Typeregionname">&lt;nome da região&gt;</combo_item>
					</combo_box>
				</panel>
				<button label="Entrar" label_selected="Entrar" name="connect_btn"/>
				<check_box label="Salvar usuário" name="remember_name_check"/>
				<button name="remove_login" tool_tip="Apagar este login salvo"/>
				<check_box label="Salvar senha" name="remember_check"/>
				<text name="create_new_account_text">Criar conta</text>
				<text name="forgot_password_text">Esqueceu o usuário ou a senha?</text>
				<panel name="grids_panel">
					<text name="grids_combo_text">Grid ou URI de login:</text>
					<combo_box name="grids_combo" tool_tip="Digite o nome do grid, a URI de login ou escolha na lista"/>
					<button name="grids_btn" label="Gerenciar grids"/>
				</panel>
			</panel>
		</scroll_container>
	</panel>
</panel>
