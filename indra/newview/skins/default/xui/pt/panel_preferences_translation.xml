<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel label="Tradução" name="translation">
 <tab_container label="Tradução" name="translation_tabs">
 <panel label="Geral" name="General" title="Geral">
 <check_box label="Ativar tradução por IA" name="enable_check"/>
 <text name="scope_label">Aplicar em:</text>
 <combo_box name="scope_combo">
 <combo_item name="im" value="im">Só IMs</combo_item>
 <combo_item name="nearby" value="nearby">Somente chat geral</combo_item>
 <combo_item name="both" value="both">Ambos</combo_item>
 </combo_box>
 <check_box label="Traduzir recebidas" name="incoming_check"/>
 <check_box label="Traduzir o que eu envio" name="outgoing_check"/>
 <text name="src_label">Eu falo:</text>
 <combo_box name="source_lang" tool_tip="Qualquer código ISO (pt, en, ja, ru, zh...). Você também pode digitar um código customizado.">
 <combo_item name="pt" value="pt">Português (pt)</combo_item>
 <combo_item name="en" value="en">Inglês (en)</combo_item>
 <combo_item name="es" value="es">Espanhol (es)</combo_item>
 <combo_item name="fr" value="fr">Francês (fr)</combo_item>
 <combo_item name="de" value="de">Alemão (de)</combo_item>
 <combo_item name="it" value="it">Italiano (it)</combo_item>
 <combo_item name="ru" value="ru">Russo (ru)</combo_item>
 <combo_item name="ja" value="ja">Japonês (ja)</combo_item>
 <combo_item name="ko" value="ko">Coreano (ko)</combo_item>
 <combo_item name="zh" value="zh">Chinês (zh)</combo_item>
 <combo_item name="ar" value="ar">Árabe (ar)</combo_item>
 <combo_item name="nl" value="nl">Holandês (nl)</combo_item>
 <combo_item name="pl" value="pl">Polonês (pl)</combo_item>
 <combo_item name="tr" value="tr">Turco (tr)</combo_item>
 <combo_item name="hi" value="hi">Hindi (hi)</combo_item>
 <combo_item name="th" value="th">Thai (th)</combo_item>
 <combo_item name="vi" value="vi">Vietnamita (vi)</combo_item>
 <combo_item name="uk" value="uk">Ucraniano (uk)</combo_item>
 </combo_box>
 <text name="dst_label">Outros falam:</text>
 <combo_box name="target_lang" tool_tip="Qualquer código ISO. Digite livremente se o idioma da galera não estiver na lista.">
 <combo_item name="en" value="en">Inglês (en)</combo_item>
 <combo_item name="pt" value="pt">Português (pt)</combo_item>
 <combo_item name="es" value="es">Espanhol (es)</combo_item>
 <combo_item name="fr" value="fr">Francês (fr)</combo_item>
 <combo_item name="de" value="de">Alemão (de)</combo_item>
 <combo_item name="it" value="it">Italiano (it)</combo_item>
 <combo_item name="ru" value="ru">Russo (ru)</combo_item>
 <combo_item name="ja" value="ja">Japonês (ja)</combo_item>
 <combo_item name="ko" value="ko">Coreano (ko)</combo_item>
 <combo_item name="zh" value="zh">Chinês (zh)</combo_item>
 <combo_item name="ar" value="ar">Árabe (ar)</combo_item>
 <combo_item name="nl" value="nl">Holandês (nl)</combo_item>
 <combo_item name="pl" value="pl">Polonês (pl)</combo_item>
 <combo_item name="tr" value="tr">Turco (tr)</combo_item>
 <combo_item name="hi" value="hi">Hindi (hi)</combo_item>
 <combo_item name="th" value="th">Thai (th)</combo_item>
 <combo_item name="vi" value="vi">Vietnamita (vi)</combo_item>
 <combo_item name="uk" value="uk">Ucraniano (uk)</combo_item>
 </combo_box>
 <text name="in_disp_label">Recebidas:</text>
 <combo_box name="incoming_display">
 <combo_item name="translation_only" value="translation_only">Só a tradução (esconde o original)</combo_item>
 <combo_item name="both" value="both">Original e tradução</combo_item>
 </combo_box>
 <text name="out_disp_label">Envio:</text>
 <combo_box name="outgoing_display">
 <combo_item name="translation_only" value="translation_only">Só a tradução (esconde o original)</combo_item>
 <combo_item name="both" value="both">Original e tradução</combo_item>
 </combo_box>
 <text name="in_color_label">Cor recebida:</text>
 <color_swatch can_apply_immediately="false" control_name="AITranslateIncomingColor" name="incoming_color"/>
 <text name="out_color_label">Cor enviada:</text>
 <color_swatch can_apply_immediately="false" control_name="AITranslateOutgoingColor" name="outgoing_color"/>
 <text name="privacy_tip">Eu falo / Outros falam = qualquer idioma (código ISO: ja, ru, zh...).&#10;Envio: você→os outros. Recebidas: os outros→você.&#10;[IA] só nas recebidas; sem linha duplicada se já estiver no idioma de destino.</text>
 </panel>
 <panel label="Grupos" name="Groups">
 <check_box label="Traduzir chats de grupo" name="groups_enable"/>
 <text name="group_mode_label">Grupos:</text>
 <combo_box name="group_mode">
 <combo_item name="all" value="all">Meus grupos</combo_item>
 <combo_item name="selected" value="selected">Só selecionados</combo_item>
 </combo_box>
 <scroll_list name="group_list" tool_tip="Ctrl+clique para selecionar vários grupos (modo Selecionados)">
 <column label="Grupo" name="name"/>
 </scroll_list>
 <button label="Atualizar grupos" name="group_refresh_btn"/>
 </panel>
 <panel label="Provedor" name="Provider">
 <text name="provider_label">Provedor:</text>
 <combo_box name="provider_combo">
 <combo_item name="openai" value="openai">OpenAI (ChatGPT)</combo_item>
 <combo_item name="anthropic" value="anthropic">Anthropic (Claude)</combo_item>
 <combo_item name="opencode_zen" value="opencode_zen">OpenCode Zen</combo_item>
 <combo_item name="openrouter" value="openrouter">OpenRouter</combo_item>
 <combo_item name="custom" value="custom">Personalizado (compatível OpenAI)</combo_item>
 </combo_box>
 <text name="key_label">Chave API:</text>
 <line_editor control_name="AITranslateApiKey" max_length_chars="256" name="api_key"/>
 <text name="url_label">URL base:</text>
 <line_editor control_name="AITranslateBaseUrl" max_length_chars="512" name="base_url"/>
 <text name="model_label">Modelo:</text>
 <line_editor control_name="AITranslateModel" max_length_chars="128" name="model"/>
 <button label="Testar conexão" name="test_btn"/>
 <text name="status_text">Não testado</text>
 <text name="provider_tip">A chave API fica salva nas configurações locais (só no seu PC).&#10;OpenCode Zen: chat/completions (ex.: mimo-v2.5-free).&#10;OpenRouter: https://openrouter.ai/api/v1 (ex.: minimax/minimax-m3:free).</text>
 </panel>
 </tab_container>
</panel>
