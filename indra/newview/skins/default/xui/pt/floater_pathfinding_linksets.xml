	<panel name="pathfinding_linksets_main">
		<text name="linksets_filter_label">Filtrar por:</text>
		<text name="linksets_name_label">Nome</text>
		<text name="linksets_desc_label">Descrição</text>
		<combo_box name="filter_by_linkset_use">
			<combo_item name="filter_by_linkset_use_none">Filtrar por uso do linkset...</combo_item>
			<combo_item name="filter_by_linkset_use_walkable">Caminhável</combo_item>
			<combo_item name="filter_by_linkset_use_static_obstacle">Obstáculo estático</combo_item>
			<combo_item name="filter_by_linkset_use_dynamic_obstacle">Obstáculo móvel</combo_item>
			<combo_item name="filter_by_linkset_use_material_volume">Volume de material</combo_item>
			<combo_item name="filter_by_linkset_use_exclusion_volume">Volume de exclusão</combo_item>
			<combo_item name="filter_by_linkset_use_dynamic_phantom">Fantasma móvel</combo_item>
		</combo_box>
		<button name="apply_filters" label="Aplicar"/>
		<button name="clear_filters" label="Limpar"/>
		<scroll_list name="objects_scroll_list">
			<column name="name" label="Nome (prim raiz)"/>
			<column name="description" label="Descrição (prim raiz)"/>
			<column name="owner" label="Dono"/>
			<column name="scripted" label="Com script"/>
			<column name="land_impact" label="Impacto"/>
			<column name="dist_from_you" label="Distância"/>
			<column name="linkset_use" label="Uso do linkset"/>
			<column name="a_percent" label="A%"/>
			<column name="b_percent" label="B%"/>
			<column name="c_percent" label="C%"/>
			<column name="d_percent" label="D%"/>
		</scroll_list>
		<text name="messaging_status">Linksets:</text>
		<button name="refresh_objects_list" label="Atualizar lista"/>
		<button name="select_all_objects" label="Selecionar todos"/>
		<button name="select_none_objects" label="Selecionar nenhum"/>
	</panel>
	<panel name="pathfinding_linksets_actions">
		<text name="linksets_actions_label">Ações nos linksets selecionados (se um linkset for removido do mundo, seus atributos podem ser perdidos):</text>
