		<text name="linksets_attributes_label">Edite os atributos dos linksets selecionados e pressione o botão para aplicar as alterações</text>
		<text name="walkability_coefficients_label">Caminhabilidade:</text>
		<text name="edit_a_label">A</text>
		<line_editor name="edit_a_value" tool_tip="Caminhabilidade para personagens do tipo A. Exemplo: humanóide."/>
		<text name="edit_b_label">B</text>
		<line_editor name="edit_b_value" tool_tip="Caminhabilidade para personagens do tipo B. Exemplo: criatura."/>
		<text name="edit_c_label">C</text>
		<line_editor name="edit_c_value" tool_tip="Caminhabilidade para personagens do tipo C. Exemplo: mecânico."/>
		<text name="edit_d_label">D</text>
		<line_editor name="edit_d_value" tool_tip="Caminhabilidade para personagens do tipo D. Exemplo: outro."/>
		<button name="apply_edit_values" label="Aplicar alterações"/>
		<text name="suggested_use_a_label">(Humanóide)</text>
		<text name="suggested_use_b_label">(Criatura)</text>
		<text name="suggested_use_c_label">(Mecânico)</text>
		<text name="suggested_use_d_label">(Outro)</text>
