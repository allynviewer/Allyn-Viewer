		<panel label="Resposta Automática" name="Autoresponse">
			<text name="Autoresponse Info">
A resposta automática envia um texto personalizado a quem lhe manda mensagem.
Curingas disponíveis: #n nome legado do usuário, #d nome de exibição,
#r SLURL da sua localização, #i seu tempo ocioso em minutos.
 </text>
			<check_box control_name="AscentInstantMessageResponseRepeat" name="AscentInstantMessageResponseRepeat" label="Auto-responder toda mensagem com resposta automática ativada" />
			<check_box control_name="AutoresponseOnlyIfAway" name="AutoresponseOnlyIfAway" label="Enviar respostas automáticas apenas quando ausente" />
			<tab_container name="Autoresponses">
				<panel label="Básico" name="Basic">
					<check_box control_name="AutoresponseAnyone" name="AutoresponseAnyone" label="Ativar" tool_tip="Enviar a mensagem na caixa abaixo para pessoas que você não silenciou." />
					<check_box control_name="AutoresponseAnyoneFriendsOnly" name="AutoresponseAnyoneFriendsOnly" label="apenas para amigos" tool_tip="Evita enviar esta resposta para quem você não conhece" />
					<check_box control_name="AutoresponseAnyoneItem" name="AutoresponseAnyoneItem" label="Enviar item" />
					<check_box control_name="AutoresponseAnyoneShow" name="AutoresponseAnyoneShow" label="Mostrar que foi enviado" />
					<text_editor font="SansSerifSmall" max_length="1100" control_name="AutoresponseAnyoneMessage" name="AutoresponseAnyoneMessage" word_wrap="true" spell_check="true" commit_on_focus_lost="true" hide_scrollbar="true" />
					<drop_target control_name="AutoresponseAnyoneItemID" name="AutoresponseAnyoneItemID" tool_tip="Solte um item aqui para enviá-lo junto com a resposta acima." />
				</panel>
				<panel label="Não Amigos" name="Nonfriends">
					<check_box control_name="AutoresponseNonFriends" name="AutoresponseNonFriends" label="Ativar" tool_tip="Enviar a mensagem na caixa abaixo para pessoas que não são seus amigos" />
					<check_box control_name="AutoresponseNonFriendsItem" name="AutoresponseNonFriendsItem" label="Enviar item" />
					<check_box control_name="AutoresponseNonFriendsShow" name="AutoresponseNonFriendsShow" label="Mostrar que foi enviado" />
					<text_editor font="SansSerifSmall" max_length="1100" control_name="AutoresponseNonFriendsMessage" name="AutoresponseNonFriendsMessage" word_wrap="true" spell_check="true" commit_on_focus_lost="true" hide_scrollbar="true" />
					<drop_target control_name="AutoresponseNonFriendsItemID" name="AutoresponseNonFriendsItemID" tool_tip="Solte um item aqui para enviá-lo junto com a resposta acima." />
				</panel>
				<panel label="Silenciado" name="Muted">
					<check_box control_name="AutoresponseMuted" name="AutoresponseMuted" label="Ativar" tool_tip="Enviar a mensagem na caixa abaixo para pessoas que você silenciou." />
					<check_box control_name="AutoresponseMutedItem" name="AutoresponseMutedItem" label="Enviar item" />
					<check_box control_name="AutoresponseMutedShow" name="AutoresponseMutedShow" label="Mostrar que foi enviado" />
					<text_editor font="SansSerifSmall" max_length="1100" control_name="AutoresponseMutedMessage" name="AutoresponseMutedMessage" word_wrap="true" spell_check="true" commit_on_focus_lost="true" hide_scrollbar="true" />
					<drop_target control_name="AutoresponseMutedItemID" name="AutoresponseMutedItemID" tool_tip="Solte um item aqui para enviá-lo junto com a resposta acima." />
				</panel>
				<panel label="Modo Ocupado" name="Busy Mode" tool_tip="Enviar a mensagem na caixa abaixo para pessoas que enviam mensagem quando você está ocupado.">
					<check_box control_name="BusyModeResponseItem" name="BusyModeResponseItem" label="Enviar item" />
					<check_box control_name="BusyModeResponseShow" name="BusyModeResponseShow" label="Mostrar que foi enviado" />
					<text_editor font="SansSerifSmall" max_length="1100" control_name="BusyModeResponse" name="BusyModeResponse" word_wrap="true" spell_check="true" commit_on_focus_lost="true" hide_scrollbar="true" />
					<drop_target control_name="BusyModeResponseItemID" name="BusyModeResponseItemID" tool_tip="Solte um item aqui para enviá-lo junto com a resposta acima." />
				</panel>
			</tab_container>
		</panel>
		<panel label="Spam" name="Spam">
			<scroll_container name="advchat_spam_scroll">
				<panel name="advchat_spam_inner">
					<check_box control_name="AntiSpamEnabled" label="Ativar Antispam" name="enable_as" />
					<button label="Redefinir filas antispam" label_selected="Redefinir filas antispam" name="reset_antispam" />
					<check_box enabled_control="AntiSpamEnabled" control_name="_NACL_AntiSpamGlobalQueue" label="Sem filas de spam específicas por tipo de mensagem" name="spammsg_checkbox" />
					<spinner enabled_control="AntiSpamEnabled" control_name="_NACL_AntiSpamTime" decimal_digits="0" increment="1" min_val="1" max_val="60" label="Tempo antispam (segundos):" tool_tip="Menor = menos sensível" name="antispamtime" />
					<spinner enabled_control="AntiSpamEnabled" control_name="_NACL_AntiSpamAmount" decimal_digits="0" increment="1" min_val="5" max_val="99999" label="Quantidade antispam:" tool_tip="Maior = menos sensível" name="antispamamount" />
					<spinner enabled_control="AntiSpamEnabled" control_name="_NACL_AntiSpamSoundMulti" decimal_digits="0" increment="1" min_val="1" max_val="99999" label="Multiplicador de quantidade para reproduções de som:" tool_tip="Maior = menos sensível" name="antispamsoundmulti" />
					<spinner enabled_control="AntiSpamEnabled" control_name="_NACL_AntiSpamSoundPreloadMulti" decimal_digits="0" increment="1" min_val="1" max_val="99999" label="Multiplicador de quantidade para pré-cargas de som:" tool_tip="Maior = menos sensível" name="antispamsoundpreloadmulti" />
					<spinner enabled_control="AntiSpamEnabled" control_name="_NACL_AntiSpamNewlines" decimal_digits="0" increment="1" min_val="5" max_val="99999" label="Quebras de linha para bloquear a mensagem na hora:" tool_tip="Maior = menos sensível" name="antispamnewlines" />
					<check_box enabled_control="AntiSpamEnabled" control_name="AntiSpamNotify" label="Notificar quando spam for bloqueado" name="Notify On Spam" tool_tip="Quando ativado, o canto inferior direito pode se tornar uma fonte de pseudo-spam sempre que spam real for bloqueado." />
					<check_box control_name="_NACL_Antispam" label="Desativar -todos- os diálogos (reinicia no login)" name="antispam_checkbox" />
					<text disabled_control="_NACL_Antispam" name="Block All Dialogs From">Bloquear Todos os Diálogos De</text>
					<check_box disabled_control="_NACL_Antispam" control_name="AntiSpamAlerts" label="Alertas" name="Alerts" />
					<check_box disabled_control="_NACL_Antispam" control_name="AntiSpamFriendshipOffers" label="Ofertas de Amizade" name="Friendship Offers" />
					<check_box disabled_control="_NACL_Antispam" control_name="AntiSpamGroupInvites" label="Todos os Convites de Grupo" name="Group Invites" />
					<check_box disabled_control="AntiSpamGroupInvites" control_name="AntiSpamGroupFeeInvites" label="Convites de Grupo com Taxa" name="Group Fee Invites" />
					<check_box disabled_control="_NACL_Antispam" control_name="AntiSpamItemOffers" label="Ofertas de Item" name="Item Offers" />
					<check_box disabled_control="_NACL_Antispam" control_name="AntiSpamScripts" label="Scripts" name="Scripts" />
					<check_box disabled_control="_NACL_Antispam" control_name="AntiSpamTeleports" label="Ofertas de TP" name="Teleport Offers" />
					<check_box disabled_control="_NACL_Antispam" control_name="AntiSpamGroupNotices" label="Notícias de Grupo" name="Group Notices" />
					<check_box disabled_control="_NACL_Antispam" control_name="AntiSpamTeleportRequests" label="Pedidos de TP" name="Teleport Requests" />
					<check_box disabled_control="_NACL_Antispam" invisibility_control="AntiSpamItemOffers" control_name="AntiSpamItemOffersLandmarks" label="Ofertas de LM" name="LM Offers" />
					<text name="Except those from:">Exceto aqueles de:</text>
					<check_box control_name="AntiSpamNotMine" label="Meus objetos" name="My objects" />
					<check_box control_name="AntiSpamNotFriend" label="Meus amigos" name="My friends" />
					<check_box control_name="EnableGestureSounds" label="Ativar Sons de Gesto" name="Enable Gesture Sounds" />
				</panel>
			</scroll_container>
		</panel>
