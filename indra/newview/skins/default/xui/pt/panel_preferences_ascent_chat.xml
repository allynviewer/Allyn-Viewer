<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="Chat Avançado" name="ascsys">
	<tab_container label="Chat Avançado" name="Ascent Chat">
		<panel label="Chat/IM" name="Chat/IM">
			<scroll_container name="advchat_im_scroll">
				<panel name="advchat_im_inner">
					<text name="objects_link_text_box">IMs:</text>
					<check_box initial_value="false" control_name="AscentInstantMessageAnnounceIncoming" label="Anunciar IMs recebidas" tool_tip="Abre uma janela de IM quando alguém começa a digitar um MI para você. Isso avisa que alguém está lhe enviando um MI antes deles apertarem Enter." name="quickstart_im_check" />
					<check_box control_name="AscentHideTypingNotification" initial_value="false" label="Não enviar 'está digitando...' em IMs" tool_tip="Parceiros de IM não verão '______ está digitando...' quando você estiver respondendo." name="hide_typing_check" />
					<check_box control_name="InstantMessagesFriendsOnly" label="Aceitar IMs apenas de Amigos" name="InstantMessagesFriendsOnly" />
					<check_box control_name="AscentAllowMUpose" initial_value="false" label="Permitir usar : como /me" tool_tip="Permite começar a frase com : para fazer um emote, igual ao /me. Usado em roleplay estilo MU/MUSH." name="allow_mu_pose_check" />
					<check_box control_name="AscentAutoCloseOOC" label="Fechar comentários OOC automaticamente" tool_tip="Adicionará automaticamente '))' a qualquer mensagem começando com '((', ou vice-versa." name="close_ooc_check" />
					<text name="objects_link_text_box2">Chat:</text>
					<check_box control_name="PlayTypingSound" initial_value="true" label="Som de digitação no chat local" tool_tip="Silencia o som de digitação, tornando-o mais suave para coisas como apresentações." name="play_typing_sound_check" />
					<check_box control_name="HideNotificationsInChat" initial_value="false" label="Não ecoar notificações no chat" name="hide_notifications_in_chat_check" />
					<check_box control_name="OptionShowGroupNameInChatIM" initial_value="false" label="Mostrar nome do grupo no chat" tool_tip="O nome do grupo também será exibido se o MI for de um chat de grupo." name="append_group_name_check" />
					<check_box control_name="ShowDisplayNameChanges" label="Mostrar mudanças de display name" tool_tip="Quando marcado, uma notificação aparecerá no chat sempre que o nome de exibição de alguém mudar." name="display_name_change" />
					<check_box control_name="UseTypingBubbles" label="Balões de digitação acima da cabeça" name="use_typing_bubbles" />
					<text name="objects_link_text_box3">Links nos nomes de objetos que falam no chat:</text>
					<radio_group control_name="LinksForChattingObjects" tool_tip="Ativa um link para mostrar o proprietário do objeto falante." name="objects_link">
						<radio_item name="no_object" value="0">Nenhum</radio_item>
						<radio_item name="others_objects" value="1">Obj. de outros</radio_item>
						<radio_item name="anyones_objects" value="2">Obj. qualquer</radio_item>
					</radio_group>
					<text name="time_format_text_box">Formato de hora:</text>
					<combo_box tool_tip="Mostrar horas no formato 12-23 ou 12PM-11PM." name="time_format_combobox">
						<combo_item name="24hours" value="default">Relógio 24 horas</combo_item>
						<combo_item name="12hours" value="default">Relógio 12 horas</combo_item>
					</combo_box>
					<check_box control_name="SecondsInChatAndIMs" initial_value="false" label="Segundos em chat/IMs" name="seconds_in_chat_and_ims_check" />
					<text name="date_format_text_box">Formato de data:</text>
					<combo_box name="date_format_combobox">
						<combo_item name="year_first" value="default">AAAA-MM-DD</combo_item>
						<combo_item name="year_first_slashes" value="default">AAAA/MM/DD</combo_item>
						<combo_item name="day_first" value="default">DD/MM/AAAA</combo_item>
						<combo_item name="month_first" value="default">MM/DD/AAAA</combo_item>
					</combo_box>
					<check_box control_name="SecondsInLog" label="Segundos no Log" name="seconds_in_log" />
				</panel>
			</scroll_container>
		</panel>
		<panel label="Interface de Chat" name="ChatUI">
			<scroll_container name="advchat_ui_scroll">
				<panel name="advchat_ui_inner">
