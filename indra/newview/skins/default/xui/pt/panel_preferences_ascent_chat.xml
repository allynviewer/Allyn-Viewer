					<text name="land_management_namesystem_text_box">Gerenciamento de Terreno:</text>
					<combo_box control_name="LandManagementNameSystem" name="land_management_namesystem_combobox">
						<combo_item name="Old Names" value="0">Nomes Antigos</combo_item>
						<combo_item name="Display Names (with Username)" value="1">Nomes de Exibição (c/Nome de Usuário)</combo_item>
						<combo_item name="Display Names only" value="2">Apenas Nomes de Exibição</combo_item>
						<combo_item name="Old Names (with Display Names)" value="3">Nomes Antigos (c/Exibição)</combo_item>
					</combo_box>
					<text name="profile_namesystem_text_box">Perfis:</text>
					<combo_box control_name="ProfileNameSystem" name="profile_namesystem_combobox">
						<combo_item name="Old Names" value="0">Nomes Antigos</combo_item>
						<combo_item name="Display Names (with Username)" value="1">Nomes de Exibição (c/Nome de Usuário)</combo_item>
						<combo_item name="Display Names only" value="2">Apenas Nomes de Exibição</combo_item>
						<combo_item name="Old Names (with Display Names)" value="3">Nomes Antigos (c/Exibição)</combo_item>
					</combo_box>
					<text name="radar_namesystem_text_box">Radar:</text>
					<combo_box control_name="RadarNameSystem" name="radar_namesystem_combobox">
						<combo_item name="Old Names" value="0">Nomes Antigos</combo_item>
						<combo_item name="Display Names (with Username)" value="1">Nomes de Exibição (c/Nome de Usuário)</combo_item>
						<combo_item name="Display Names only" value="2">Apenas Nomes de Exibição</combo_item>
						<combo_item name="Old Names (with Display Names)" value="3">Nomes Antigos (c/Exibição)</combo_item>
					</combo_box>
					<text name="speaker_namesystem_text_box">Palestrantes:</text>
					<combo_box control_name="SpeakerNameSystem" name="speaker_namesystem_combobox">
						<combo_item name="Old Names" value="0">Nomes Antigos</combo_item>
						<combo_item name="Display Names (with Username)" value="1">Nomes de Exibição (c/Nome de Usuário)</combo_item>
						<combo_item name="Display Names only" value="2">Apenas Nomes de Exibição</combo_item>
						<combo_item name="Old Names (with Display Names)" value="3">Nomes Antigos (c/Exibição)</combo_item>
					</combo_box>
					<check_box control_name="UseConciseIMButtons" label="Botões na mesma linha do nome para IMs (Afeta novas IMs)" name="im_concise_butt" />
					<check_box control_name="UseConciseGroupChatButtons" label="Botões na linha do nome do grupo (afeta novos chats)" name="group_concise_butt" />
					<check_box control_name="UseConciseConferenceButtons" label="Botões no título da conferência (afeta novas conferências)" name="conf_concise_butt" />
					<check_box control_name="LiruLegacyLogLaunch" label="Botão de log abre editor de texto externo" name="legacy_log_launch" />
