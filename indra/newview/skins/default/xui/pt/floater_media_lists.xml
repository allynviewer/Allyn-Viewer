<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="floatermedialists" title="Filtro de mídia">
	<floater.string name="EnterUrlAllow">Digite o domínio ou URL para sempre permitir:</floater.string>
	<floater.string name="EnterUrlDeny">Digite o domínio ou URL para nunca permitir:</floater.string>
	<layout_stack name="lists_layout_stack">
		<layout_panel name="whitelist_layout_panel">
			<scroll_list name="whitelist">
				<column name="list" label="Domínios permitidos"/>
			</scroll_list>
			<layout_stack name="whitelist_buttons_layout_stack">
				<layout_panel name="whitelist_buttons_panel_add">
					<button name="add_whitelist" label="Adicionar..."/>
				</layout_panel>
				<layout_panel name="whitelist_buttons_panel_remove">
					<button name="remove_whitelist" label="Remover"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="blacklist_layout_panel">
			<scroll_list name="blacklist">
				<column name="list" label="Domínios bloqueados"/>
			</scroll_list>
			<layout_stack name="blacklist_buttons_layout_stack">
				<layout_panel name="blacklist_buttons_panel_add">
					<button name="add_blacklist" label="Adicionar..."/>
				</layout_panel>
				<layout_panel name="blacklist_buttons_panel_remove">
					<button name="remove_blacklist" label="Remover"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</floater>
