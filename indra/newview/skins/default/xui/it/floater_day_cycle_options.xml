<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="Day Cycle Floater" title="Editor del ciclo giorno/notte">
	<tab_container name="Day Cycle Tabs">
		<panel label="Ciclo giorno/notte" name="Day Cycle">
			<button label="?" name="WLDayCycleHelp"/>
			<text name="WL12am">0:00</text>
			<text name="WL3am">3:00</text>
			<text name="WL6am">6:00</text>
			<text name="WL9amHash">9:00</text>
			<text name="WL12pmHash">12:00</text>
			<text name="WL3pm">15:00</text>
			<text name="WL6pm">18:00</text>
			<text name="WL9pm">21:00</text>
			<text name="WL12am2">24:00</text>
			<button label="Aggiungi chiave" label_selected="Aggiungi chiave" name="WLAddKey"/>
			<button label="Cancella chiave" label_selected="Cancella chiave" name="WLDeleteKey"/>
			<text name="WLCurKeyFrameText">Impostazioni fotogramma chiave:</text>
			<text name="WLCurKeyTimeText">Ora della chiave:</text>
			<spinner label="Ora" name="WLCurKeyHour"/>
			<spinner label="Min" name="WLCurKeyMin"/>
			<text name="WLCurKeyTimeText2">Predefinito della chiave:</text>
			<combo_box label="Predefinito" name="WLKeyPresets"/>
			<text name="DayCycleText">Aggancio:</text>
			<combo_box label="5 min" name="WLSnapOptions"/>
			<text name="DayCycleText2">Durata del ciclo:</text>
			<spinner label="Ore" name="WLLengthOfDayHour"/>
			<spinner label="Min" name="WLLengthOfDayMin"/>
			<spinner label="Sec" name="WLLengthOfDaySec"/>
			<text name="DayCycleText3">Anteprima:</text>
			<button label="Avvia" label_selected="Avvia" name="WLAnimSky"/>
			<button label="Arresta" label_selected="Arresta" name="WLStopAnimSky"/>
			<button label="Usa ora della regione" label_selected="Vai all&apos;ora della regione" name="WLUseLindenTime"/>
			<text name="KeyFramePresetsText">Predefiniti:</text>
			<button label="Nuovo" label_selected="Nuovo" name="DayCycleNewPreset"/>
			<button label="Salva" label_selected="Salva" name="DayCycleSavePreset"/>
			<button label="Elimina" label_selected="Elimina" name="DayCycleDeletePreset"/>
		</panel>
	</tab_container>
	<string name="DaycycleDefaultNames">Default:Happy%20Bivouac</string>
</floater>
