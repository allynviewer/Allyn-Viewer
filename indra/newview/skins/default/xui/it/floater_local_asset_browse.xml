<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="local_bitmap_browser_floater" title="Browser bitmap locali">
	<button name="add_btn" label="Aggiungi"/>
	<button name="del_btn" label="Rimuovi"/>
	<button name="upload_btn" label="Carica"/>
	<button name="more_btn" label="Altro"/>
	<button name="less_btn" label="Meno"/>
	<scroll_list name="bitmap_list">
		<column name="bitmap_name" label="Nome"/>
		<column name="bitmap_uuid" label="UUID"/>
	</scroll_list>
	<text name="path_caption_text">Percorso locale:</text>
	<text name="uuid_caption_text">UUID locale:</text>
	<texture_picker name="texture_view" label="Texture"/>
	<check_box name="keep_updating_checkbox" label="Continua ad aggiornare" tool_tip="Attiva o disattiva i controlli periodici se la bitmap di origine sul disco è stata aggiornata"/>
	<combo_box name="type_combobox">
		<combo_item name="type_texture">Texture</combo_item>
		<combo_item name="type_sculptie">Sculptmap</combo_item>
		<combo_item name="type_layer">Vestiti</combo_item>
	</combo_box>
	<text name="time_caption_text">Tempo:</text>
	<text name="time_text">(data)</text>
	<text name="link_caption_text">Link:</text>
	<text name="link_text">(stato del link)</text>
	<text name="name_caption_text">Nome:</text>
</floater>
