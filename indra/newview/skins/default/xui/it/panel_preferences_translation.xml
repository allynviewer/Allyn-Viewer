<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel label="Traduzione" name="translation">
 <tab_container label="Traduzione" name="translation_tabs">
 <panel label="Generale" name="General">
 <check_box label="Abilita traduzione IA" name="enable_check"/>
 <text name="scope_label">Applica a:</text>
 <combo_box name="scope_combo">
 <combo_item name="im" value="im">Solo IM</combo_item>
 <combo_item name="nearby" value="nearby">Solo chat locale</combo_item>
 <combo_item name="both" value="both">Tutti</combo_item>
 </combo_box>
 <check_box label="Traduci in arrivo" name="incoming_check"/>
 <check_box label="Traduci in partenza" name="outgoing_check"/>
 <text name="src_label">Io parlo:</text>
 <combo_box name="source_lang" tool_tip="Qualsiasi codice ISO (pt, en, ja, ru, zh...). Puoi scrivere un codice personalizzato.">
 <combo_item name="pt" value="pt">Portoghese (pt)</combo_item>
 <combo_item name="en" value="en">Inglese (en)</combo_item>
 <combo_item name="es" value="es">Spagnolo (es)</combo_item>
