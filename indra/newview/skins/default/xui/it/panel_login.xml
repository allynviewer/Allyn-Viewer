<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<string name="online_users_title">UTENTI ONLINE</string>
	<string name="online_allyn_label">ALLYN VIEWER</string>
	<string name="online_sl_label">SECOND LIFE</string>
	<panel name="login_form_bg">
		<scroll_container name="login_form_scroll">
			<panel name="login_form_inner">
				<panel name="online_users_panel">
					<text name="online_users_title">UTENTI ONLINE</text>
				</panel>
				<text name="login_title">ALLYN VIEWER</text>
				<text name="login_subtitle">Accedi per continuare</text>
				<text name="name_label">Nome utente</text>
				<text name="password_text">Password</text>
				<panel name="location_panel">
					<text name="start_location_text">Posizione iniziale</text>
					<combo_box name="start_location_combo">
						<combo_item name="MyHome">Casa mia</combo_item>
						<combo_item name="MyLastLocation">Ultima posizione</combo_item>
						<combo_item name="Typeregionname">&lt;regione&gt;</combo_item>
					</combo_box>
				</panel>
				<button label="Accedi" label_selected="Accedi" name="connect_btn"/>
				<check_box label="Salva nome utente" name="remember_name_check"/>
				<button name="remove_login" tool_tip="Elimina questo login salvato"/>
				<check_box label="Salva password" name="remember_check"/>
				<text name="create_new_account_text">Crea account</text>
				<text name="forgot_password_text">Password dimenticata?</text>
				<panel name="grids_panel">
					<text name="grids_combo_text">Grid o URI di login:</text>
					<combo_box name="grids_combo" tool_tip="Nome del grid o URI di login"/>
					<button name="grids_btn" label="Gestione grid"/>
				</panel>
			</panel>
		</scroll_container>
	</panel>
</panel>
