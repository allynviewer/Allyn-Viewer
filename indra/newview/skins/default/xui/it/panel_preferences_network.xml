<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="network" label="Connessione">
	<button name="open_cache_loc" label="Aprire" />
	<scroll_container name="network_scroll">
		<panel name="network_scroll_inner">
			<text name="text_box">
		Larghezza massima di banda:
	</text>
			<slider name="max_bandwidth" left_delta="150" />
			<text name="text_box2" left_delta="190">
		kbps (kilobits al secondo)
	</text>
			<text name="text_box3">Larghezza banda texture:</text>
			<slider name="tex_bandwidth" left_delta="150" />
			<text name="text_box4" left_delta="190">
		kbps (kilobits al secondo)
	</text>
			<text name="use_http_for" visible="false">Usa HTTP per:</text>
			<check_box label="Texture" name="http_textures" visible="false" />
			<check_box label="Inventario" name="http_inventory" visible="false" />
			<text name="cache_size_label_l">
		Dimensione della cache del disco:
	</text>
			<slider name="cache_size" left_delta="156" />
			<text name="text_box5">
		MB
	</text>
			<text name="cache_location_label">
		Percorso della cache del disco:
	</text>
			<line_editor name="cache_location" width="470" />
			<button name="set_cache" label="Imposta" />
			<button name="clear_cache" label="Elimina contenuto" tool_tip="Elimina contenuto della cache" width="120" left_delta="20" />
			<button name="reset_cache" label="Reimposta" />
			<check_box name="connection_port_enabled" label="Connessione mediante porta personalizzata" />
			<check_box name="socks5_proxy_enabled" />
			<spinner name="connection_port" label="Numero porta:" />
			<text name="socks5_auth_label">Proxy HTTP:</text>
			<radio_group name="socks5_http_proxy_type" width="380">
				<radio_item name="None" tool_tip="Nessun proxy HTTP" width="50">Nessuno</radio_item>
				<radio_item name="Socks" tool_tip="Usa Socks per proxy HTTP" width="50">Socks</radio_item>
				<radio_item name="Web" tool_tip="Usa proxy web per proxy HTTP" width="50">Web</radio_item>
			</radio_group>
			<check_box label="Abilita proxy SOCKS 5" name="socks5_proxy_enabled" width="256" />
			<text name="socks5_host_label">Host Socks 5:</text>
			<line_editor name="socks5_proxy_host" tool_tip="Il nome o l'indirizzo IP del proxy SOCKS5 che desideri utilizzare" />
			<spinner label="Numero porta:" name="socks5_proxy_port" />
			<text name="socks5_auth_label2">Autenticazione Socks5:</text>
			<radio_group name="socks5_auth" width="420">
				<radio_item name="None" tool_tip="Nessuna autenticazione">Nessuno</radio_item>
				<radio_item name="UserPass" tool_tip="Autenticazione nome utente/password">Username/Password</radio_item>
			</radio_group>
			<text name="socks5_username_label">Username:</text>
			<line_editor name="socks5_proxy_username" tool_tip="Username per il proxy Socks5" />
			<text name="socks5_password_label">Password:</text>
			<line_editor name="socks5_proxy_password" tool_tip="Password per il proxy Socks5" />
		</panel>
	</scroll_container>
</panel>
