<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_experience_info">
	<text name="title" />
	<scroll_container name="xp_scroll">
		<panel name="scrolling_panel">
			<layout_stack>
				<layout_panel name="image_panel">
					<texture_picker name="logo" />
				</layout_panel>
				<layout_panel>
					<text name="experience_title" />
				</layout_panel>
				<layout_panel name="description panel">
					<expandable_text name="experience_description" />
				</layout_panel>
				<layout_panel name="location panel">
					<text name="Location">Расположение:</text>
					<text name="LocationTextText">someplace</text>
					<button name="teleport_btn" label="Телепортироваться" />
					<button name="map_btn" label="Карта" />
				</layout_panel>
				<layout_panel name="marketplace panel">
					<text name="Location">Магазин Marketplace:</text>
					<text name="LocationTextText">someplace</text>
				</layout_panel>
				<layout_panel>
					<text name="ContentRating">Рейтинг:</text>
					<text name="ContentRatingText">Взрослый</text>
					<text name="Owner">Владелец:</text>
					<text name="OwnerText">Kyle</text>
					<button name="edit_btn" label="Редактировать" />
				</layout_panel>
			</layout_stack>
		</panel>
	</scroll_container>
</panel>
