<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<multi_floater name="floater_chatterbox">
	<panel name="panel_littletoolbar">
		<button name="chat_btn" tool_tip="Показать панель чата (Enter)" />
		<flyout_button name="communicate_btn" label="Общаться" tool_tip="Общайтесь со своими друзьями и группами." />
		<button name="fly_btn" label="Полёт" tool_tip="Начни летать. Используйте E/C или PgUp/PgDn, чтобы летать вверх и вниз." />
	</panel>
	<panel name="panel_unfocused_floater">
		<text name="titlebar_focused">Без фокуса</text>
		<combo_box name="combo_box_1" label="Комбобокс" />
		<text_editor name="Chat History Editor">Текст</text_editor>
	</panel>
	<panel name="panel_focused_floater">
		<text name="titlebar_focused">В фокусе</text>
		<icon name="chatterbox_tab_container" />
		<tab_container name="chatterbox_tabs">
			<panel name="test_1" label="Сосредоточенный">
				<slider name="SliderTestName" label="Слайдер" />
				<check_box name="check_box_test_1" label="Да" />
				<check_box name="check_box_test_2" label="Нет" />
				<text_editor name="Chat History Editor">Текст чата</text_editor>
			</panel>
			<panel name="test_2" label="Несосредоточенный" />
		</tab_container>
	</panel>
</multi_floater>
