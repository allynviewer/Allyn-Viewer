			<icon name="section_audio_rule" />
			<slider name="Doppler Effect" label="Эффект Доплера" />
			<slider name="Rolloff Factor" label="Коэффициент спада (по умолчанию)" />
			<slider name="Underwater Rolloff Factor" label="Фактор спада (под водой)" />
			<spinner name="currency_change_threshold" label="[CURRENCY] изменение порога:" />
			<spinner name="Health Change Threshold" label="Порог изменения здоровья" />
