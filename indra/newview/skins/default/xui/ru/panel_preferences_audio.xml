<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="Media panel" label="Аудио и видео">
	<scroll_container name="audio_scroll">
		<panel name="audio_scroll_inner">
			<text name="muting_text">ОБЪЕМ</text>
			<icon name="section_vol_rule" />
			<panel name="Volume Panel" label="Объем" />
			<text name="Media Filtering">МЕДИА ФИЛЬТРАЦИЯ</text>
			<icon name="section_filter_rule" />
			<radio_group name="filter_group">
				<radio_item name="0">Выключенный</radio_item>
				<radio_item name="1">Только черный список</radio_item>
				<radio_item name="2">Быстрый</radio_item>
			</radio_group>
			<text name="streaming_prefs_text">СТРИМИНГ</text>
			<icon name="section_stream_rule" />
