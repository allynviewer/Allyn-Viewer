<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<mimetypes name="default">
	<defaultlabel>(Неизвестный)</defaultlabel>
	<defaultwidget>никто</defaultwidget>
	<defaultimpl>media_plugin_cef</defaultimpl>
	<widgetset name="web">
		<label name="web_label">Веб-контент</label>
		<icon>icn_media_web.tga</icon>
		<default_type>text/html</default_type>
		<tooltip name="web_tooltip">В этом месте есть веб-контент</tooltip>
		<playtip name="web_playtip">Показать веб-контент</playtip>
		<allow_resize>true</allow_resize>
		<allow_looping>false</allow_looping>
	</widgetset>
	<widgetset name="movie">
		<label name="movie_label">Фильм</label>
		<default_type>video/*</default_type>
		<icon>icn_media_movie.tga</icon>
		<tooltip name="movie_tooltip">Здесь можно посмотреть фильм</tooltip>
		<playtip name="movie_playtip">Воспроизвести фильм</playtip>
		<allow_resize>false</allow_resize>
		<allow_looping>true</allow_looping>
	</widgetset>
	<widgetset name="image">
		<label name="image_label">Изображение</label>
		<icon>icn_media_web.tga</icon>
		<default_type>image/*</default_type>
		<tooltip name="image_tooltip">По этому адресу есть изображение</tooltip>
		<playtip name="image_playtip">Посмотреть изображение этого места</playtip>
		<allow_resize>false</allow_resize>
		<allow_looping>false</allow_looping>
	</widgetset>
	<widgetset name="audio">
		<label name="audio_label">Аудио</label>
		<icon>icn_media_web.tga</icon>
		<default_type>audio/*</default_type>
		<tooltip name="audio_tooltip">Здесь есть аудио</tooltip>
		<playtip name="audio_playtip">Воспроизвести аудио этого места</playtip>
		<allow_resize>false</allow_resize>
		<allow_looping>true</allow_looping>
	</widgetset>
	<widgetset name="none">
		<label name="none_label">No Content</label>
		<default_type>нет/нет</default_type>
		<icon>icn_media_web.tga</icon>
		<tooltip name="none_tooltip">No media here</tooltip>
		<playtip name="none_playtip" />
		<allow_resize>false</allow_resize>
		<allow_looping>false</allow_looping>
	</widgetset>
	<scheme name="rtsp">
		<label name="rtsp_label">Потоковое вещание в реальном времени</label>
		<widgettype>movie</widgettype>
		<impl>media_plugin_libvlc</impl>
	</scheme>
	<scheme name="example">
		<label name="example_label">Example Plugin scheme trigger</label>
		<widgettype>movie</widgettype>
		<impl>media_plugin_example</impl>
	</scheme>
	<scheme name="libvlc">
		<label name="libvlc_label">LibVLC supported media</label>
		<widgettype>movie</widgettype>
		<impl>media_plugin_libvlc</impl>
	</scheme>
	<mimetype name="blank">
		<label name="blank_label">- Никто -</label>
		<widgettype>никто</widgettype>
		<impl>media_plugin_cef</impl>
	</mimetype>
	<mimetype name="none/none">
		<label name="none/none_label">- Никто -</label>
		<widgettype>никто</widgettype>
		<impl>media_plugin_cef</impl>
	</mimetype>
	<mimetype name="audio/*">
