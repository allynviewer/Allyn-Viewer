<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
	<string name="online_users_title">ПОЛЬЗОВАТЕЛИ ОНЛАЙН</string>
	<string name="online_allyn_label">ALLYN VIEWER</string>
	<string name="online_sl_label">SECOND LIFE</string>
	<panel name="login_form_bg">
		<scroll_container name="login_form_scroll">
			<panel name="login_form_inner">
				<panel name="online_users_panel">
					<text name="online_users_title">ПОЛЬЗОВАТЕЛИ ОНЛАЙН</text>
				</panel>
				<text name="login_title">ALLYN VIEWER</text>
				<text name="login_subtitle">Войдите, чтобы продолжить</text>
				<text name="name_label">Имя пользователя</text>
				<text name="password_text">Пароль</text>
				<panel name="location_panel">
					<text name="start_location_text">Стартовая локация</text>
					<combo_box name="start_location_combo">
						<combo_item name="MyHome">Мой дом</combo_item>
						<combo_item name="MyLastLocation">Последняя локация</combo_item>
						<combo_item name="Typeregionname">&lt;регион&gt;</combo_item>
					</combo_box>
				</panel>
				<button label="Войти" label_selected="Войти" name="connect_btn"/>
				<check_box label="Сохранить имя пользователя" name="remember_name_check"/>
				<button name="remove_login" tool_tip="Удалить выбранные сохранённые данные входа"/>
				<check_box label="Сохранить пароль" name="remember_check"/>
				<text name="create_new_account_text">Создать аккаунт</text>
				<text name="forgot_password_text">Забыли имя или пароль?</text>
				<panel name="grids_panel">
					<text name="grids_combo_text">Грид или URI входа:</text>
					<combo_box name="grids_combo" tool_tip="Введите имя грида или URI входа, либо выберите из списка"/>
					<button name="grids_btn" label="Менеджер гридов"/>
				</panel>
			</panel>
		</scroll_container>
	</panel>
</panel>
