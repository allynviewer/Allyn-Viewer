<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="floater_web_content" title="Веб-браузер">
	<layout_stack name="stack1">
		<layout_panel name="nav_controls">
			<button name="back" tool_tip="Вернуться назад" />
			<button name="forward" tool_tip="Перейти вперед" />
			<button name="stop" tool_tip="Остановить навигацию" />
			<button name="reload" tool_tip="Обновить страницу" />
			<combo_box name="address" tool_tip="Введите URL здесь" />
			<icon name="media_secure_lock_flag" tool_tip="Безопасный просмотр" />
			<button name="popexternal" tool_tip="Откройте текущий URL-адрес в браузере вашего рабочего стола." />
		</layout_panel>
		<layout_panel name="external_controls">
			<web_browser name="webbrowser" />
		</layout_panel>
		<layout_panel name="status_bar">
			<text name="statusbartext" />
			<progress_bar name="statusbarprogress" />
		</layout_panel>
	</layout_stack>
</floater>
